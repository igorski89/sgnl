# A throw-away dev instance in a VM on the operator's Mac (bin/sgnl-dev,
# instance/docs/PLAN-dev-env.md). Private names under the reserved .test
# TLD, an own certificate authority, generated secrets (SGNL_SECRETS=csv:,
# never the vault), every outgoing mail caught by Mailpit.
SGNL_ENV=dev
SGNL_ORG_NAME="SGNL Dev"
SGNL_DOMAIN=example.test
SGNL_APPS_DOMAIN=sgnl.example.test
# An SSH alias (~/.sgnl-dev/ssh_config): Lima forwards the VM's SSH to localhost.
SGNL_HOST=sgnl-dev
SGNL_REALM=dev
SGNL_TZ=UTC
SGNL_PREFIX=dev-sgnl
# Mailpit in the VM instead of SES (config/deploy.stalwart.dev.yml); the
# name resolves to the VM, where Mailpit listens on the Docker bridge.
SGNL_SMTP_HOST=smtp.example.test
SGNL_COTENANT=
SGNL_ORG_SLUG=dev
# Garage in the VM instead of Cloudflare R2 (host/dev/garage.sh): on the
# Docker bridge, where the backup's restic container reaches it.
SGNL_R2_ENDPOINT=172.17.0.1:3900
SGNL_BACKUP_S3_SCHEME=http
SGNL_BACKUP_BUCKET=dev-sgnl-backups
SGNL_ALERT_EMAIL=owner@personal.example
SGNL_ADMIN_USER=alice
