# Kamal's secrets: names only. Every value is looked up at deploy time
# through bin/sgnl-secret (never stored here), so this file is tracked.
#
# One shared file for every service in this repo — each deploy.*.yml is
# invoked as `kamal deploy -c config/deploy.<name>.yml`, which selects
# the config file but NOT a separate secrets file, so all secrets across
# all sgnl services live here together (same shape as ../../cotenant/.kamal/secrets).
# bin/stalwart-apply also sources this file to fill stalwart/plan*.ndjson.
#
# Every value comes from bin/sgnl-secret (Vaultwarden, organisation
# collection "SGNL", since 2026-11; the macOS Keychain before), never a
# raw credential here.
# Run Kamal through bin/sgnl-env so all secrets are fetched in one go:
#   bin/sgnl-unlock
#   bin/sgnl-env kamal deploy -c config/deploy.<name>.yml
# The commented "bin/sgnl-secret --set" lines below make each value once
# (generated ones are piped in; for copied ones it asks, hidden).
#
# Naming: every credential is "<company>-<project>-<what>", here
# "example-sgnl-*" (vault items, IAM users, API tokens), so other
# companies' sgnl deployments on the same laptop/accounts can't collide
# with this one; bin/sgnl-secret adds the prefix to short names. Add each
# one once with:
#   bin/sgnl-secret --set <short-name>        # hidden prompt: paste, Enter

# --- Shared AWS SES SMTP credentials -----------------------------------
# SES SMTP credentials (a derived username/password pair from the SES
# console, sending region eu-central-1), not an AWS access key. Used by
# Stalwart's outbound relay (via bin/stalwart-apply) and by Keycloak,
# Vaultwarden, Forgejo, OpenCloud and the backup alerts for notification mail.
#   bin/sgnl-secret --set ses-smtp-username   # paste at the hidden prompt
#   bin/sgnl-secret --set ses-smtp-password   # paste at the hidden prompt
AWS_SES_SMTP_USERNAME=$(bin/sgnl-secret ses-smtp-username)
AWS_SES_SMTP_PASSWORD=$(bin/sgnl-secret ses-smtp-password)

# --- Stalwart -------------------------------------------------------------
# Break-glass admin that bin/stalwart-apply authenticates as, deployed as
# STALWART_RECOVERY_ADMIN. The stored value is the whole "admin:<password>"
# string, so this line is a plain $(...) like every other one.
#   printf %s "admin:$(openssl rand -base64 48 | tr -d '/+=' | cut -c1-48)" | bin/sgnl-secret --set stalwart-recovery-admin
STALWART_RECOVERY_ADMIN=$(bin/sgnl-secret stalwart-recovery-admin)
# The ses-relay@ account (SES forwarder Lambda) uses an app password,
# created by bin/stalwart-relay-app-password straight into the vault
# (example-sgnl-ses-relay-app-password) and Secrets Manager. Kamal
# doesn't need it.
# Cloudflare API token for Stalwart's DNS-01 certificate challenge. Sent
# into Stalwart's datastore by bin/stalwart-apply, not deployed as env.
# Scope it to Zone:DNS:Edit on example.com only, and add the VPS IP
# (203.0.113.10) under "Client IP Address Filtering".
#   bin/sgnl-secret --set cloudflare-api-token   # paste at the hidden prompt
CLOUDFLARE_API_TOKEN=$(bin/sgnl-secret cloudflare-api-token)

# --- Bulwark ----------------------------------------------------------------
#   printf %s "$(openssl rand -base64 32)" | bin/sgnl-secret --set bulwark-session-secret
#   printf %s "$(openssl rand -base64 24)" | bin/sgnl-secret --set bulwark-admin-password
BULWARK_SESSION_SECRET=$(bin/sgnl-secret bulwark-session-secret)
BULWARK_ADMIN_PASSWORD=$(bin/sgnl-secret bulwark-admin-password)

# --- Forgejo ------------------------------------------------------------------
# Generated with the image's own generator (forgejo generate secret ...):
#   for name gen in forgejo-secret-key SECRET_KEY forgejo-internal-token INTERNAL_TOKEN forgejo-lfs-jwt-secret LFS_JWT_SECRET forgejo-oauth2-jwt-secret JWT_SECRET; do
#     printf %s "$(ssh root@203.0.113.10 "docker run --rm codeberg.org/forgejo/forgejo:15.0.9-rootless forgejo generate secret $gen 2>/dev/null" | tr -d '\r\n')" | bin/sgnl-secret --set $name; done   # zsh
# SECRET_KEY encrypts secrets in Forgejo's DB: losing it breaks restores.
FORGEJO_SECRET_KEY=$(bin/sgnl-secret forgejo-secret-key)
FORGEJO_INTERNAL_TOKEN=$(bin/sgnl-secret forgejo-internal-token)
FORGEJO_LFS_JWT_SECRET=$(bin/sgnl-secret forgejo-lfs-jwt-secret)
FORGEJO_OAUTH2_JWT_SECRET=$(bin/sgnl-secret forgejo-oauth2-jwt-secret)

# --- OpenCloud -----------------------------------------------------------------
# Break-glass admin in OpenCloud's own user store (no login form: login is
# Keycloak only). Meets OpenCloud's password policy (upper, lower, digit, special).
#   printf %s "$(openssl rand -base64 33 | tr -d '/+=' | cut -c1-28)Aa1!" | bin/sgnl-secret --set opencloud-admin-password
OPENCLOUD_ADMIN_PASSWORD=$(bin/sgnl-secret opencloud-admin-password)


# --- Keycloak (docs/USERS.md, docs/DEPLOY.md) ------------------------------
#   for s in keycloak-postgres-password keycloak-bootstrap-admin-password; do
#     printf %s "$(openssl rand -base64 33 | tr -d '/+=' | cut -c1-32)" | bin/sgnl-secret --set $s; done
# The bootstrap admin password is only read on Keycloak's first start.
KEYCLOAK_POSTGRES_PASSWORD=$(bin/sgnl-secret keycloak-postgres-password)
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=$(bin/sgnl-secret keycloak-bootstrap-admin-password)
# OIDC client secrets (Keycloak stores them as given; keycloak/realm.yaml
# gets them from here via bin/sgnl-keycloak-apply). sgnl-agent = the
# agent's service account (bin/sgnl-kc).
#   for c in bulwark vaultwarden forgejo sgnl-agent; do
#     printf %s "$(openssl rand -hex 32)" | bin/sgnl-secret --set keycloak-$c-client-secret; done
KEYCLOAK_BULWARK_CLIENT_SECRET=$(bin/sgnl-secret keycloak-bulwark-client-secret)
KEYCLOAK_VAULTWARDEN_CLIENT_SECRET=$(bin/sgnl-secret keycloak-vaultwarden-client-secret)
KEYCLOAK_FORGEJO_CLIENT_SECRET=$(bin/sgnl-secret keycloak-forgejo-client-secret)
KEYCLOAK_SGNL_AGENT_CLIENT_SECRET=$(bin/sgnl-secret keycloak-sgnl-agent-client-secret)
KEYCLOAK_GRAFANA_CLIENT_SECRET=$(bin/sgnl-secret keycloak-grafana-client-secret)
# MCP gateway (instance/docs/PLAN-mcp.md):
#   openssl rand -hex 32 | tr -d '\n' | bin/sgnl-secret --set keycloak-sgnl-mcp-client-secret
KEYCLOAK_SGNL_MCP_CLIENT_SECRET=$(bin/sgnl-secret keycloak-sgnl-mcp-client-secret)

# --- Monitoring (instance/docs/PLAN-monitoring.md, config/deploy.monitoring.yml) ------
# Grafana's local admin: break-glass only, everyday login is Keycloak.
#   openssl rand -base64 36 | tr -d '/+=\n' | bin/sgnl-secret --set grafana-admin-password
GRAFANA_ADMIN_PASSWORD=$(bin/sgnl-secret grafana-admin-password)

# --- listmonk (config/deploy.listmonk.yml) ---------------------------------
#   openssl rand -base64 33 | tr -d '/+=\n' | cut -c1-32 | bin/sgnl-secret --set listmonk-postgres-password
#   openssl rand -base64 33 | tr -d '/+=\n' | cut -c1-32 | bin/sgnl-secret --set listmonk-admin-password
#   openssl rand -hex 32 | tr -d '\n' | bin/sgnl-secret --set keycloak-listmonk-client-secret
# The admin password is break-glass only (local super admin); everyday
# login is Keycloak. The client secret goes into keycloak/realm.yaml and
# listmonk's settings (bin/sgnl-listmonk-setup).
LISTMONK_POSTGRES_PASSWORD=$(bin/sgnl-secret listmonk-postgres-password)
LISTMONK_ADMIN_PASSWORD=$(bin/sgnl-secret listmonk-admin-password)
KEYCLOAK_LISTMONK_CLIENT_SECRET=$(bin/sgnl-secret keycloak-listmonk-client-secret)
