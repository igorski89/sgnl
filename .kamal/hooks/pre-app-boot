#!/usr/bin/env bash
# Kamal 2 has no `files:` for app containers (only for accessories), so
# this uploads each service's config/secret files to /opt/sgnl/<name>/ on
# its hosts before every container boot (setup, deploy, redeploy, app
# boot). config/deploy.<name>.yml bind-mounts them read-only from there.
#
# Paths are relative to the service's directory in this repo. Modes are
# kept as they are locally. Stalwart runs as the "stalwart" user, so its dir and files are
# made world-readable - config.json holds no secrets.
set -euo pipefail
cd "$(dirname "$0")/../.."
source lib/instance.sh

case "${KAMAL_SERVICE:-}" in
  sgnl-stalwart)
    src=stalwart dest=stalwart dir_mode=755 world_readable=1
    files=(config.json) ;;
  sgnl-authelia)
    # Runs as root; no secrets in the file (they're environment variables).
    src=authelia dest=authelia dir_mode=755 world_readable=1
    files=(configuration.yml) ;;
  sgnl-opencloud)
    # Container runs as uid 1000: world-readable, no secrets in these.
    src=opencloud dest=opencloud dir_mode=755 world_readable=1
    files=(csp.yaml proxy.yaml) ;;
  *) exit 0 ;;
esac

for f in "${files[@]}"; do
  [[ -s "$src/$f" ]] || { echo "pre-app-boot: missing $src/$f (see docs/DEPLOY.md)" >&2; exit 1; }
done

# Fill the instance values ({{SGNL_*}}, bin/sgnl-render) into a private
# copy; that copy is what gets uploaded. Modes are kept.
out=$(mktemp -d)
trap 'rm -rf "${out:?}"' EXIT
for f in "${files[@]}"; do
  bin/sgnl-render "$src/$f" > "$out/$f"
  chmod "$(stat -f %Lp "$src/$f" 2>/dev/null || stat -c %a "$src/$f")" "$out/$f"   # macOS || Linux
done

# bin/sgnl-config-dump: print what would be uploaded, upload nothing.
if [[ -n ${SGNL_HOOK_DUMP:-} ]]; then
  for f in "${files[@]}"; do printf "==> /opt/sgnl/%s/%s\n" "$dest" "$f"; cat "$out/$f"; done
  exit 0
fi

dest=/opt/sgnl/$dest
for host in ${KAMAL_HOSTS//,/ }; do
  echo "pre-app-boot: uploading ${#files[@]} file(s) to $host:$dest"
  # COPYFILE_DISABLE: no macOS ._ files. --no-same-owner: owned by root.
  COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata -C "$out" -cf - "${files[@]}" |
    ssh "root@$host" "set -e; install -d -m $dir_mode $dest
      tar -xf - --no-same-owner -C $dest
      ${world_readable:+chmod -R a+rX $dest}"
done
