#!/usr/bin/env python3
"""People and groups in Keycloak (realm example), as the agent's
service account `sgnl-agent` (client credentials; its secret comes from
the Keychain, item example-sgnl-keycloak-sgnl-agent-client-secret).
Rights: manage/view users, groups, events - not realm settings (those are
keycloak/realm.yaml). See docs/USERS.md.

  bin/sgnl-kc list
  bin/sgnl-kc show <user>
  bin/sgnl-kc add-user <user> "<First Last>" [<email>]   # email default <user>@example.com
  bin/sgnl-kc add-to-group <user> <group>...
  bin/sgnl-kc remove-from-group <user> <group>...
  bin/sgnl-kc setup-email <user> [hours]   # email: set own password + register a passkey (default 24 h)
  bin/sgnl-kc invite <user> "<First Last>" <personal-email> [hours]   # default 72 h
  bin/sgnl-kc finish-invite <user> <group>...   # after they set password + passkey
  bin/sgnl-kc disable <user> | enable <user>
  bin/sgnl-kc logout <user>                # ends all of that person's sessions, incl. offline tokens
  bin/sgnl-kc events [<user>] [max]        # recent login events

finish-invite, add-to-group, remove-from-group, disable and enable then
run bin/sgnl-vault-sync (Vaultwarden members and groups follow Keycloak),
if the instance has vaultwarden/org.yaml.

Invite: a new person can't read <user>@ before they can log in, so the
set-up email goes to a personal address. Until finish-invite they're only
in sgnl_invited: they can reach their account page but no app (the apps
need sgnl_users), so no app creates an account from the personal address
(Forgejo would name it after it). finish-invite sets <user>@example.com
and swaps sgnl_invited for the given groups (sgnl_users is always added).

Creating someone with a *given* id (to keep their Authelia `sub`) needs
the master admin: bin/sgnl-kcimport (one-time migration step).
"""
import json, os, subprocess, sys, urllib.error, urllib.parse, urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import instance  # noqa: E402  (instance/sgnl.env)
I = instance.load()
BASE = f"https://id.{I['SGNL_APPS_DOMAIN']}"
REALM = I["SGNL_REALM"]
ADMIN = f"{BASE}/admin/realms/{REALM}"
DOMAIN = I["SGNL_DOMAIN"]


def keychain(name):
    # bin/sgnl-secret (Vaultwarden); the name is historical.
    r = subprocess.run([os.path.join(os.path.dirname(os.path.abspath(__file__)), "sgnl-secret"), name], capture_output=True, text=True)
    if r.returncode:
        sys.exit("sgnl-kc: " + r.stderr.strip())
    return r.stdout.strip()


def request(method, url, body=None, form=None, token=None):
    headers, data = {"Accept": "application/json"}, None
    if token:
        headers["Authorization"] = f"Bearer {token}"
    if body is not None:
        data, headers["Content-Type"] = json.dumps(body).encode(), "application/json"
    if form is not None:
        data, headers["Content-Type"] = urllib.parse.urlencode(form).encode(), "application/x-www-form-urlencoded"
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=data, headers=headers, method=method)) as r:
            raw = r.read()
            return r.status, (json.loads(raw) if raw and r.headers.get_content_type() == "application/json" else None), r.headers
    except urllib.error.HTTPError as e:
        sys.exit(f"sgnl-kc: {method} {url.replace(ADMIN, '')} -> HTTP {e.code} {e.read().decode()[:200]}")


_token = None
def api(method, path, body=None, **params):
    global _token
    if _token is None:
        _, t, _ = request("POST", f"{BASE}/realms/{REALM}/protocol/openid-connect/token",
                          form={"grant_type": "client_credentials", "client_id": "sgnl-agent",
                                "client_secret": keychain("keycloak-sgnl-agent-client-secret")})
        _token = t["access_token"]
    q = ("?" + urllib.parse.urlencode(params)) if params else ""
    return request(method, f"{ADMIN}{path}{q}", body=body, token=_token)


def user(name):
    _, found, _ = api("GET", "/users", username=name, exact="true")
    if not found:
        sys.exit(f"sgnl-kc: no user {name}")
    return found[0]


def update_user(u, **fields):
    # PUT the whole representation: a partial one can clear profile
    # attributes (user profile is on in Keycloak 24+).
    _, full, _ = api("GET", f"/users/{u['id']}")
    api("PUT", f"/users/{u['id']}", {**full, **fields})


def group_ids():
    _, gs, _ = api("GET", "/groups", briefRepresentation="true", max="200")
    return {g["name"]: g["id"] for g in gs}


def user_groups(uid):
    _, gs, _ = api("GET", f"/users/{uid}/groups")
    return sorted(g["name"] for g in gs)


def setup_email(u, hours):
    api("PUT", f"/users/{u['id']}/execute-actions-email", ["UPDATE_PASSWORD", "webauthn-register"],
        lifespan=str(hours * 3600), client_id="account-console",
        redirect_uri=f"{BASE}/realms/{REALM}/account/")
    print(f"set-up email sent to {u.get('email')} (valid {hours} h): set password, register a passkey")


def add_user(name, full, email):
    first, _, last = full.partition(" ")
    _, _, h = api("POST", "/users", {"username": name, "email": email, "emailVerified": True,
                                      "firstName": first, "lastName": last, "enabled": True})
    return h["Location"].rsplit("/", 1)[-1]


def set_groups(uid, add=(), remove=()):
    ids = group_ids()
    for g in (*add, *remove):
        if g not in ids:
            sys.exit(f"sgnl-kc: no group {g} (groups live in keycloak/realm.yaml)")
    for g in add:
        api("PUT", f"/users/{uid}/groups/{ids[g]}")
    for g in remove:
        api("DELETE", f"/users/{uid}/groups/{ids[g]}")


def vault_sync():
    """Vaultwarden members/groups follow Keycloak (bin/sgnl-vault-sync), if
    the instance has an organisation config. A failure only warns: the
    Keycloak change stands; re-run bin/sgnl-vault-sync later."""
    if not os.path.exists(os.path.join(instance.instance_dir(), "vaultwarden", "org.yaml")):
        return
    r = subprocess.run([os.path.join(os.path.dirname(os.path.abspath(__file__)), "sgnl-vault-sync")],
                       capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    if r.returncode:
        print(f"warning: Vaultwarden not synced ({out.splitlines()[-1] if out else 'failed'}); "
              "run bin/sgnl-vault-sync", file=sys.stderr)
    else:
        print("vaultwarden: " + "; ".join(l for l in out.splitlines() if not l.startswith(("Keycloak:", "  "))))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip()); return
    cmd, args = argv[0], argv[1:]
    if cmd == "list":
        _, users, _ = api("GET", "/users", max="500", briefRepresentation="false")
        for u in sorted(users, key=lambda u: u["username"]):
            if u["username"].startswith("service-account-"):
                continue
            name = " ".join(x for x in (u.get("firstName"), u.get("lastName")) if x)
            flags = "" if u["enabled"] else "  [DISABLED]"
            print(f'{u["username"]}\t{u.get("email", "")}\t{name}\t{",".join(user_groups(u["id"]))}{flags}')
    elif cmd == "show" and len(args) == 1:
        u = user(args[0]); uid = u["id"]
        _, creds, _ = api("GET", f"/users/{uid}/credentials")
        _, sessions, _ = api("GET", f"/users/{uid}/sessions")
        print(json.dumps({"id": uid, "username": u["username"], "email": u.get("email"),
                          "enabled": u["enabled"], "groups": user_groups(uid),
                          "requiredActions": u.get("requiredActions", []),
                          "credentials": sorted(c["type"] for c in creds),
                          "sessions": len(sessions)}, indent=2))
    elif cmd == "add-user" and len(args) in (2, 3):
        email = args[2] if len(args) == 3 else f"{args[0]}@{DOMAIN}"
        uid = add_user(args[0], args[1], email)
        print(f"created {args[0]} ({email}), id {uid}; no password yet (setup-email)")
    elif cmd in ("add-to-group", "remove-from-group") and len(args) >= 2:
        uid = user(args[0])["id"]
        set_groups(uid, **{"add" if cmd == "add-to-group" else "remove": args[1:]})
        print(f"{args[0]}: {','.join(user_groups(uid))}")
        vault_sync()
    elif cmd == "setup-email" and len(args) in (1, 2):
        setup_email(user(args[0]), int(args[1]) if len(args) == 2 else 24)
    elif cmd == "invite" and len(args) in (3, 4):
        uid = add_user(args[0], args[1], args[2])
        set_groups(uid, add=["sgnl_invited"])
        print(f"created {args[0]} ({args[2]}, invited), id {uid}")
        setup_email(user(args[0]), int(args[3]) if len(args) == 4 else 72)
    elif cmd == "finish-invite" and len(args) >= 1:
        u = user(args[0])
        _, creds, _ = api("GET", f"/users/{u['id']}/credentials")
        types = {c["type"] for c in creds}
        if not {"password", "webauthn"} <= types:
            sys.exit(f"sgnl-kc: {args[0]} hasn't finished set-up yet (credentials: {sorted(types) or 'none'})")
        email = f"{args[0]}@{DOMAIN}"
        update_user(u, email=email, emailVerified=True)
        set_groups(u["id"], add=["sgnl_users", *[g for g in args[1:] if g != "sgnl_users"]], remove=["sgnl_invited"])
        print(f"{args[0]}: email {email}, groups {','.join(user_groups(u['id']))}")
        vault_sync()
    elif cmd in ("disable", "enable") and len(args) == 1:
        u = user(args[0])
        update_user(u, enabled=cmd == "enable")
        if cmd == "disable":
            api("POST", f"/users/{u['id']}/logout")
        print(f"{args[0]}: {cmd}d" + (" and logged out everywhere" if cmd == "disable" else ""))
        vault_sync()
    elif cmd == "logout" and len(args) == 1:
        api("POST", f"/users/{user(args[0])['id']}/logout")
        print(f"{args[0]}: all sessions ended (incl. offline tokens)")
    elif cmd == "events" and len(args) <= 2:
        params = {"max": args[1] if len(args) == 2 else "20"}
        if args:
            params["user"] = user(args[0])["id"]
        _, evs, _ = api("GET", "/events", **params)
        import datetime
        for e in evs:
            t = datetime.datetime.fromtimestamp(e["time"] / 1000).strftime("%Y-%m-%d %H:%M:%S")
            print(f'{t}  {e["type"]:<28} {e.get("clientId", ""):<18} {e.get("ipAddress", "")}  {e.get("error", "")}')
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
