#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/../lib/instance.sh"
# Runs kcadm.sh (Keycloak's admin CLI) inside the Keycloak container,
# logged in as the master realm's admin. The password goes over ssh stdin,
# never argv. Break-glass and one-offs the service account can't do
# (realm settings, deleting users, lockouts); day to day: bin/sgnl-kc.
#
#   bin/sgnl-kcadm get users -r example
cd "$(dirname "$0")/.."
HOST=root@$SGNL_HOST
pw=$("$(dirname "$0")/sgnl-secret" keycloak-bootstrap-admin-password)
args=$(printf '%q ' "$@")
printf '%s\n' "$pw" | ssh "$HOST" "c=\$(docker ps -qf label=service=sgnl-keycloak -f label=role=web | head -1)
  docker exec -i \$c sh -c 'read -r P; export HOME=/tmp
    /opt/keycloak/bin/kcadm.sh config credentials --server http://localhost:8080 --realm master --user admin --password \"\$P\" >/dev/null 2>&1 &&
    exec /opt/keycloak/bin/kcadm.sh $args'"
