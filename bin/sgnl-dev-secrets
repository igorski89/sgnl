#!/usr/bin/env python3
"""Generates every secret of a DEV instance into one CSV file (the
csv:<path> store of bin/sgnl-secret), so a dev environment never touches
the vault. Refuses any instance whose sgnl.env doesn't say SGNL_ENV=dev.

  bin/sgnl-dev-secrets --instance dev <csv-path>   (bin/sgnl-dev up runs it)

Names: every `bin/sgnl-secret <name>` in .kamal/secrets and bin/*, with the
instance's prefix. Existing values in the file are kept (re-run adds new
names only). Values are random, in the shape each secret needs; the TLS
pair comes from the dev CA (bin/sgnl-dev ca). The file is mode 600 and
must stay outside git.
"""
import base64, csv, glob, os, re, secrets, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))
import instance  # noqa: E402

I = instance.load()
if I.get("SGNL_ENV") != "dev":
    sys.exit("sgnl-dev-secrets: refusing: this instance is not SGNL_ENV=dev")
if len(sys.argv) != 2:
    sys.exit(__doc__)
OUT = sys.argv[1]
PREFIX = I["SGNL_PREFIX"] + "-"


def rnd(n=32):
    return secrets.token_hex(n)


def rsa_b64():
    key = subprocess.run(["openssl", "genrsa", "2048"], capture_output=True, check=True).stdout
    return base64.b64encode(key).decode()


def saml_pair():
    d = subprocess.run(["mktemp", "-d"], capture_output=True, text=True, check=True).stdout.strip()
    subprocess.run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "3650",
                    "-subj", "/CN=sgnl-dev-saml", "-keyout", f"{d}/k", "-out", f"{d}/c"],
                   capture_output=True, check=True)
    k, c = (base64.b64encode(open(f"{d}/{x}", "rb").read()).decode() for x in "kc")
    subprocess.run(["rm", "-rf", d])
    return k, c


def value(short, pair):
    if short.endswith("-jwk-b64"):
        return rsa_b64()
    if short in ("id-saml-key-b64", "authelia-saml-key-b64"):
        return pair[0]
    if short in ("id-saml-cert-b64", "authelia-saml-cert-b64"):
        return pair[1]
    if short == "stalwart-recovery-admin":
        return "admin:" + secrets.token_urlsafe(36)[:48]
    if short == "opencloud-admin-password":
        return secrets.token_urlsafe(21)[:28] + "Aa1!"
    if short in ("ses-smtp-username",):
        return "mailpit"
    if short.startswith("cloudflare-") or short.startswith("aws-"):
        return "none-in-dev"
    if short.endswith("-password") or short.endswith("-secret") or short.endswith("-key"):
        return secrets.token_urlsafe(32)
    return rnd()


names = set()
for f in [os.path.join(ROOT, ".kamal", "secrets")] + glob.glob(os.path.join(ROOT, "bin", "*")):
    try:
        text = open(f).read()
    except (UnicodeDecodeError, IsADirectoryError):
        continue
    names |= set(re.findall(r"bin/sgnl-secret(?: --set)? ([a-z0-9][a-z0-9-]+)", text))
names = {n for n in names if "-" in n and not n.endswith("-") and n != "short-name"}
# Real values that tools create on the running dev instance (bin/sgnl-dev
# bootstrap): a random one here would only hide that they are missing.
names -= {"ses-relay-app-password", "backup-s3-access-key-id", "backup-s3-secret-access-key", "restic-password",
          "vaultwarden-org-client-id", "vaultwarden-org-client-secret"}

have = {}
if os.path.exists(OUT):
    with open(OUT, newline="") as f:
        have = {r["Username"]: r["Password"] for r in csv.DictReader(f)}
pair = saml_pair()
added = 0
for short in sorted(names):
    full = PREFIX + short
    if full not in have:
        have[full] = value(short, pair)
        added += 1

os.makedirs(os.path.dirname(os.path.abspath(OUT)), mode=0o700, exist_ok=True)
old = os.umask(0o077)
tmp = OUT + ".tmp"
with open(tmp, "w", newline="") as f:
    w = csv.DictWriter(f, fieldnames=["Username", "Password"])
    w.writeheader()
    for k in sorted(have):
        w.writerow({"Username": k, "Password": have[k]})
os.replace(tmp, OUT)
os.umask(old)
print(f"{OUT}: {len(have)} secrets ({added} new), mode 600")
