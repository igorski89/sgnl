#!/usr/bin/env bash
# Throw-away SGNL environments in a Lima VM on the operator's Mac
# (instance/docs/PLAN-dev-env.md). The dev instance is instance.dev/
# (private .test names, own CA, generated secrets, Mailpit for mail);
# nothing here can reach prod's vault, DNS, mail or backups.
#
#   bin/sgnl-dev up           create + start the VM, CA, secrets, VM prep
#   bin/sgnl-dev bootstrap    deploy and configure the apps (idempotent)
#   bin/sgnl-dev kamal ...    Kamal against the VM: -d dev, dev secrets
#   bin/sgnl-dev run <cmd>    any repo tool against the dev instance
#   bin/sgnl-dev hosts        the /etc/hosts line for the Mac (sudo, once)
#   bin/sgnl-dev seed         test people with password + passkey (no human):
#                             alice (admin), bob, eve (in no group); files in ~/.sgnl-dev/<name>/people
#   bin/sgnl-dev check        every app in a browser as alice (admin), bob (user) and
#                             eve (no group: refused everywhere), then a new document
#                             in the office (end to end)
#   bin/sgnl-dev vault        the dev vault's organisation (alice owns it), the bw CLI
#                             logged in to it, bin/sgnl-vault-sync, invitations accepted
#                             (idempotent; seed runs it)
#   bin/sgnl-dev unlock       the dev vault's CLI unlocked again (after 12 h; no prompt)
#   bin/sgnl-dev smoke tokens   MCP tokens for the two smoke accounts (after seed)
#   bin/sgnl-dev smoke [flags]  the MCP smoke test against dev (e.g. -read-only)
#   bin/sgnl-dev inbound <file.eml> <from> <rcpt>[,...]
#                             deliver a mail as if SES received it (real forwarder code)
#   bin/sgnl-dev stop | start
#   bin/sgnl-dev destroy      delete the VM and its secrets (asks); keeps the
#                             dev CA, so the Mac's trust in it stays valid
#
# From nothing: up, hosts (once per Mac), bootstrap, seed (includes vault).
#
# Env: SGNL_DEV_NAME (default sgnl-dev), SGNL_DEV_SSH_PORT (default 60022).
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${SGNL_DEV_NAME:-sgnl-dev}
PORT=${SGNL_DEV_SSH_PORT:-60022}
STATE=$HOME/.sgnl-dev
ENVDIR=$STATE/$NAME
export SGNL_SECRETS=csv:$ENVDIR/secrets.csv
CAROOT=$STATE/ca
# Never the prod vault: the bw CLI gets this environment's own data dir and
# session file (the dev vault, bin/sgnl-dev vault); the shared prod session
# never reaches dev tools (lib/bwsession.py checks the dir, too).
unset BW_SESSION
export BITWARDENCLI_APPDATA_DIR=$ENVDIR/bw SGNL_BW_SESSION_FILE=$ENVDIR/bw-session
set -- --instance dev "$@"; source lib/instance.sh   # always the dev instance (lib/instance.py)
[[ ${SGNL_ENV:-} == dev ]] || { echo "sgnl-dev: instance.dev is not SGNL_ENV=dev" >&2; exit 1; }
# Only ever the VM: the dev instance's host must be this VM's SSH alias, which
# points at Lima's forward on the Mac itself (never a real server).
[[ $SGNL_HOST == "$NAME" ]] || { echo "sgnl-dev: SGNL_HOST=$SGNL_HOST is not the VM ($NAME)" >&2; exit 1; }
if [[ -s $STATE/ssh_config ]] && [[ $(ssh -G "$NAME" 2>/dev/null | awk '$1=="hostname"{print $2}') != 127.0.0.1 ]]; then
  echo "sgnl-dev: SSH alias $NAME doesn't point at 127.0.0.1 (the VM's forward)" >&2; exit 1
fi

ca_bundle() {
  # Tools on the Mac (Python, curl, Ruby) trust the dev CA plus the usual
  # public roots: one bundle, through SSL_CERT_FILE.
  local b=$STATE/ca-bundle.pem
  if [[ ! -s $b || $CAROOT/rootCA.pem -nt $b ]]; then
    { security find-certificate -a -p /System/Library/Keychains/SystemRootCertificates.keychain; cat "$CAROOT/rootCA.pem"; } > "$b.tmp" && mv "$b.tmp" "$b"
  fi
  export SSL_CERT_FILE=$b REQUESTS_CA_BUNDLE=$b CURL_CA_BUNDLE=$b
}

secrets_file() {
  # Kamal reads .kamal/secrets.dev for -d dev: the shared names plus the
  # dev certificate (kamal-proxy's custom TLS). Generated, not in git.
  { cat .kamal/secrets
    echo 'SGNL_TLS_CERT_PEM=$(bin/sgnl-secret tls-cert-pem)'
    echo 'SGNL_TLS_KEY_PEM=$(bin/sgnl-secret tls-key-pem)'; } > .kamal/secrets.dev
}

ca_and_cert() {
  install -d -m 700 "$STATE" "$CAROOT" "$ENVDIR"
  # The dev CA may sign ONLY names under .test (X.509 name constraints):
  # trusted on the Mac, it still can't vouch for any real site.
  if [[ ! -s $CAROOT/rootCA.pem ]]; then
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 3650 \
      -subj "/O=SGNL dev/CN=SGNL dev CA (only .test names)" \
      -keyout "$CAROOT/rootCA-key.pem" -out "$CAROOT/rootCA.pem" \
      -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
      -addext "keyUsage=critical,keyCertSign,cRLSign" \
      -addext "nameConstraints=critical,permitted;DNS:test,permitted;DNS:.test" 2>/dev/null
    chmod 400 "$CAROOT/rootCA-key.pem"
  fi
  if [[ ! -s $ENVDIR/tls.crt ]]; then
    openssl req -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -subj "/CN=*.$SGNL_APPS_DOMAIN" \
      -keyout "$ENVDIR/tls.key" -out "$ENVDIR/tls.csr" 2>/dev/null
    openssl x509 -req -in "$ENVDIR/tls.csr" -CA "$CAROOT/rootCA.pem" -CAkey "$CAROOT/rootCA-key.pem" \
      -CAcreateserial -days 825 -out "$ENVDIR/tls.crt" -extfile <(printf '%s\n' \
        "subjectAltName=DNS:*.$SGNL_APPS_DOMAIN,DNS:$SGNL_APPS_DOMAIN,DNS:$SGNL_DOMAIN,DNS:*.$SGNL_DOMAIN" \
        "basicConstraints=critical,CA:FALSE" "keyUsage=critical,digitalSignature" "extendedKeyUsage=serverAuth" \
        "subjectKeyIdentifier=hash" "authorityKeyIdentifier=keyid:always") 2>/dev/null
    rm -f "$ENVDIR/tls.csr"; chmod 600 "$ENVDIR/tls.key"
  fi
  bin/sgnl-dev-secrets "$ENVDIR/secrets.csv"
  python3 - "$ENVDIR" "$CAROOT" "$SGNL_PREFIX" <<'PY'
import csv, os, sys
d, ca, prefix = sys.argv[1:]
p = d + "/secrets.csv"
rows = {r["Username"]: r["Password"] for r in csv.DictReader(open(p))}
rows[prefix + "-tls-cert-pem"] = open(d + "/tls.crt").read() + open(ca + "/rootCA.pem").read()
rows[prefix + "-tls-key-pem"] = open(d + "/tls.key").read()
os.umask(0o077)
with open(p + ".tmp", "w", newline="") as f:
    w = csv.DictWriter(f, fieldnames=["Username", "Password"]); w.writeheader()
    for k in sorted(rows): w.writerow({"Username": k, "Password": rows[k]})
os.replace(p + ".tmp", p)
PY
}

ssh_alias() {
  cat > "$STATE/ssh_config" <<EOF
# SGNL dev VMs (bin/sgnl-dev). Lima forwards the VM's SSH to localhost.
Host $NAME
  HostName 127.0.0.1
  Port $PORT
  User root
  IdentityFile $HOME/.lima/_config/user
  IdentitiesOnly yes
  UserKnownHostsFile $HOME/.sgnl-dev/known_hosts
  StrictHostKeyChecking accept-new
EOF
  if ! grep -q "~/.sgnl-dev/ssh_config" ~/.ssh/config 2>/dev/null; then
    { printf '# Added for SGNL dev VMs (bin/sgnl-dev); remove this line to undo.\nInclude ~/.sgnl-dev/ssh_config\n\n'; cat ~/.ssh/config 2>/dev/null; } > ~/.ssh/config.new
    mv ~/.ssh/config.new ~/.ssh/config
  fi
}

vm() { ssh "$NAME" "$@"; }
# The bw CLI on the dev vault, logged in as its owner and unlocked with the
# owner's stored master password (bin/sgnl-dev vault created both).
dev_unlock() {
  local vj=$ENVDIR/people/$SGNL_ADMIN_USER.vault.json
  [[ -s $vj ]] || { echo "no dev vault owner yet: bin/sgnl-dev vault" >&2; return 1; }
  field() { python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d[sys.argv[2]][sys.argv[3]] if sys.argv[3] else d[sys.argv[2]], end="")' "$vj" "$1" "${2:-}"; }
  export NODE_EXTRA_CA_CERTS=$CAROOT/rootCA.pem
  install -d -m 700 "$BITWARDENCLI_APPDATA_DIR"
  if [[ $(bw status | python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])') == unauthenticated ]]; then
    bw config server "https://vault.$SGNL_APPS_DOMAIN" >/dev/null
    BW_CLIENTID=$(field user client_id) BW_CLIENTSECRET=$(field user client_secret) bw login --apikey >/dev/null
  fi
  (umask 077; BW_MASTER=$(field master) bw unlock --passwordenv BW_MASTER --raw > "$SGNL_BW_SESSION_FILE.tmp")
  mv "$SGNL_BW_SESSION_FILE.tmp" "$SGNL_BW_SESSION_FILE"
  echo "dev vault unlocked for the dev tools (bw data in $BITWARDENCLI_APPDATA_DIR, 12 h)"
}
web() { vm "docker ps -q -f name=^$1-web-dev-"; }   # a Kamal app's running container
stw() {   # stalwart-cli as the dev mail server's recovery admin
  local r; r=$(bin/sgnl-secret stalwart-recovery-admin)
  STALWART_URL=https://mail.$SGNL_APPS_DOMAIN STALWART_USER=${r%%:*} STALWART_PASSWORD=${r#*:} stalwart-cli "$@" </dev/null
}
has_secret() { bin/sgnl-secret "$1" >/dev/null 2>&1; }
K() { bin/sgnl-env kamal "$@" -d dev; }
step() { printf '\n== %s\n' "$*"; }

bootstrap() {
  secrets_file; ca_bundle
  local ca=/opt/sgnl/dev-ca pc=/root/.kamal/proxy/apps-config

  step "base image of the mail server (arm64, in the Mac's local registry)"
  local img; img=$(sed -n 's/^ *STALWART_IMAGE: *//p' config/deploy.stalwart.dev.yml)
  curl -sf "http://${img%%/*}/v2/$(cut -d/ -f2 <<<"${img%:*}")/tags/list" | grep -q "\"${img##*:}\"" ||
    { echo "missing $img: build it as in docs/DEV.md (the mail server's arm64 base image)" >&2; return 1; }

  step "kamal-proxy with the dev certificate"
  # Kamal places an accessory's custom certificate only during an app
  # deploy: those of the accessories with a web page go in first. dev-tls is the root placeholder's.
  vm "set -e; docker network inspect kamal >/dev/null 2>&1 || docker network create kamal >/dev/null
      install -d $pc/dev-tls; cp $ca/tls.crt $ca/tls.key $pc/dev-tls/
      for svc in sgnl-stalwart-dev sgnl-collabora-dev sgnl-bulwark-dev sgnl-dashy-dev; do
        install -d $pc/\$svc/tls; cat $ca/tls.crt $ca/ca.pem > $pc/\$svc/tls/cert.pem; cp $ca/tls.key $pc/\$svc/tls/key.pem
      done"
  vm 'docker ps -q -f name=^kamal-proxy$' | grep -q . || K proxy boot -c config/deploy.id.yml

  step "Mailpit (every mail ends here; the login server checks it at start)"
  vm 'docker ps -aq -f name=^sgnl-mailpit$' | grep -q . || K accessory boot mailpit -c config/deploy.stalwart.yml

  step "login server"
  K deploy -c config/deploy.id.yml
  bin/sgnl-env bin/sgnl-root-placeholder sgnl-id-root id
  local c; c=$(web sgnl-id)
  for g in sgnl_users forgejo_users admins developers sgnl_invited mcp_users; do
    vm "docker exec $c authelia groups create $g --config /config/configuration.yml >/dev/null 2>&1" || true
  done

  step "mail server"
  # It publishes 465/993 itself: no overlap, stop the old one first (as on prod).
  [[ -z $(web sgnl-stalwart) ]] || K app stop -c config/deploy.stalwart.yml
  K deploy -c config/deploy.stalwart.yml
  bin/sgnl-env bin/stalwart-apply
  bin/sgnl-env bin/stalwart-apply stalwart/plan-oidc.ndjson
  bin/sgnl-env host/dev/stalwart-cert.sh "$ENVDIR/tls.crt" "$ENVDIR/tls.key" "$CAROOT/rootCA.pem"
  vm "docker restart \$(docker ps -q -f name=^sgnl-stalwart-web-dev-) >/dev/null"
  sleep 15
  # smoke@: the smoke accounts are its members (set on the server, as in prod).
  local gid uid
  gid=$(stw query Account --where name=smoke --fields id --json | python3 -c 'import json,sys; print(json.loads(sys.stdin.readline())["id"])')
  for u in sgnl-smoke sgnl-smoke2; do
    uid=$(stw query Account --where name=$u --fields id --json | python3 -c 'import json,sys; print(json.loads(sys.stdin.readline())["id"])')
    stw update Account "$uid" --json "{\"memberGroupIds\":{\"$gid\":true}}" >/dev/null
  done
  # The forwarder's login (host/dev/inbound.mjs); prod's goes to AWS.
  has_secret ses-relay-app-password || bin/sgnl-env bin/stalwart-relay-app-password

  step "drive (OpenCloud + Tika) and office (Collabora)"
  bin/sgnl-env bin/sgnl-collabora-proof-key
  vm 'docker ps -aq -f name=^sgnl-collabora-web$' | grep -q . || K accessory boot web -c config/deploy.collabora.yml
  vm 'docker ps -aq -f name=^sgnl-tika$' | grep -q . || K accessory boot tika -c config/deploy.opencloud.yml
  K deploy -c config/deploy.opencloud.yml

  step "webmail (Bulwark) and vault (a dev Vaultwarden)"
  vm 'docker ps -aq -f name=^sgnl-bulwark-web$' | grep -q . || K accessory boot web -c config/deploy.bulwark.yml
  K deploy -c config/deploy.vaultwarden.yml

  step "git (Forgejo) and newsletters (listmonk)"
  # Neither can run two containers on one database: stop first (as on prod).
  [[ -z $(web sgnl-forgejo) ]] || K app stop -c config/deploy.forgejo.yml
  K deploy -c config/deploy.forgejo.yml
  bin/sgnl-env bin/sgnl-forgejo-setup auth
  # A new Forgejo has no repositories dir until the first repo; its restore
  # drill (forgejo doctor) needs it.
  vm "docker exec \$(docker ps -q -f name=^sgnl-forgejo-web-dev-) mkdir -p /var/lib/gitea/git/repositories"
  vm "docker restart \$(docker ps -q -f name=^sgnl-forgejo-web-dev-) >/dev/null"
  [[ -z $(web sgnl-listmonk) ]] || K app stop -c config/deploy.listmonk.yml
  K deploy -c config/deploy.listmonk.yml
  bin/sgnl-env bin/sgnl-listmonk-setup

  step "home page (Dashy) and monitoring"
  vm 'docker ps -aq -f name=^sgnl-dashy-web$' | grep -q . || K accessory boot web -c config/deploy.dashy.yml
  for a in victoriametrics vmagent vmalert alertmanager node-exporter cadvisor victorialogs vector vmalert-logs; do
    vm "docker ps -aq -f name=^sgnl-$a\$" | grep -q . || K accessory boot $a -c config/deploy.monitoring.yml
  done
  K deploy -c config/deploy.monitoring.yml
  bin/sgnl-env bin/sgnl-grafana-setup

  step "MCP gateway"
  K deploy -c config/deploy.mcp.yml
  # Its audit volume belongs to the distroless user (65532); prod's was set once by hand.
  vm "docker run --rm -v sgnl_mcp_audit:/data alpine sh -c 'chown 65532:65532 /data && chmod 700 /data'
      docker restart \$(docker ps -q -f name=^sgnl-mcp-web-dev-) >/dev/null"

  step "backups to Garage"
  scp -q host/dev/garage.sh "$NAME:/root/garage.sh"
  local keys; keys=$(vm "bash /root/garage.sh $SGNL_BACKUP_BUCKET")
  if [[ -n $keys ]]; then
    printf '%s' "${keys%% *}" | bin/sgnl-secret --set "$SGNL_PREFIX-backup-s3-access-key-id"
    printf '%s' "${keys#* }" | bin/sgnl-secret --set "$SGNL_PREFIX-backup-s3-secret-access-key"
  fi
  unset keys
  has_secret restic-password || openssl rand -base64 32 | tr -d '\n' | bin/sgnl-secret --set "$SGNL_PREFIX-restic-password"
  bin/sgnl-env bin/sgnl-backup-install

  step "done: bin/sgnl-dev seed next"
}

case ${1:-} in
  up)
    command -v limactl >/dev/null || { echo "brew install lima" >&2; exit 1; }
    if ! limactl list -q 2>/dev/null | grep -qx "$NAME"; then
      sed "s/@SSH_PORT@/$PORT/" host/dev/lima.yaml > "$STATE/$NAME.yaml"
      limactl create --name "$NAME" --tty=false --mount-none "$STATE/$NAME.yaml"
    fi
    limactl start "$NAME" >/dev/null
    ssh_alias
    ca_and_cert
    secrets_file
    scp -q host/dev/vm-prep.sh "$NAME:/root/vm-prep.sh"
    ssh "$NAME" "bash /root/vm-prep.sh $SGNL_DOMAIN" < "$CAROOT/rootCA.pem"
    scp -q "$ENVDIR/tls.crt" "$ENVDIR/tls.key" "$NAME:/opt/sgnl/dev-ca/"
    ssh "$NAME" 'chmod 644 /opt/sgnl/dev-ca/tls.crt /opt/sgnl/dev-ca/tls.key'
    echo "up: $NAME. Next: bin/sgnl-dev hosts (once per Mac), then bin/sgnl-dev bootstrap" ;;
  bootstrap) bootstrap ;;
  unlock) dev_unlock ;;
  vault)
    ca_bundle
    export NODE_EXTRA_CA_CERTS=$CAROOT/rootCA.pem
    : "${PLAYWRIGHT_CORE:=$(ls "$HOME"/Work/authelia/sgnl/e2e/browser/node_modules/playwright-core/index.mjs 2>/dev/null || echo playwright-core)}"
    export PLAYWRIGHT_CORE
    node host/dev/vault-owner.mjs "$SGNL_ADMIN_USER" "$SGNL_APPS_DOMAIN" "$SGNL_ORG_NAME" "$ENVDIR/people"
    vj=$ENVDIR/people/$SGNL_ADMIN_USER.vault.json
    field() { python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d[sys.argv[2]][sys.argv[3]] if sys.argv[3] else d[sys.argv[2]], end="")' "$vj" "$1" "${2:-}"; }
    field org client_id | bin/sgnl-secret --set "$SGNL_PREFIX-vaultwarden-org-client-id"
    field org client_secret | bin/sgnl-secret --set "$SGNL_PREFIX-vaultwarden-org-client-secret"
    dev_unlock
    out=$(bin/sgnl-env bin/sgnl-vault-sync); echo "$out"
    # Seeded people with a pending invitation accept it, then the sync confirms them.
    invited=$(sed -n 's/^invited, waiting for them to accept the email: //p' <<<"$out" | tr ',' '\n' | sed 's/@.*//; s/ //g')
    if [[ -n $invited ]]; then
      for u in $invited; do
        [[ -s $ENVDIR/people/$u.passkey.json ]] && node host/dev/vault-join.mjs "$u" "$SGNL_APPS_DOMAIN" "$ENVDIR/people"
        sleep 2
      done
      bin/sgnl-env bin/sgnl-vault-sync | grep -E '^(confirmed|invited)' || true
    fi ;;
  smoke)
    ca_bundle
    export NODE_EXTRA_CA_CERTS=$CAROOT/rootCA.pem
    : "${PLAYWRIGHT_CORE:=$(ls "$HOME"/Work/authelia/sgnl/e2e/browser/node_modules/playwright-core/index.mjs 2>/dev/null || echo playwright-core)}"
    export PLAYWRIGHT_CORE
    if [[ ${2:-} == tokens ]]; then
      for u in sgnl-smoke sgnl-smoke2; do
        node host/dev/mcp-token.mjs "$u" "$SGNL_APPS_DOMAIN" "$SGNL_REALM" "$ENVDIR/people" "$ENVDIR/tokens"
        sleep 2   # passkey sign count from the clock: logins at least 1 s apart
      done; exit 0
    fi
    shift
    # The runner is sgnl-mcp's cmd/sgnl-mcp-smoke (SGNL_MCP_DIR, default ~/Work/sgnl-mcp), built on first use.
    bin=$STATE/bin/sgnl-mcp-smoke src=${SGNL_MCP_DIR:-$HOME/Work/sgnl-mcp}
    if [[ ! -x $bin ]]; then
      mkdir -p "$STATE/bin"
      (cd "$src" && v=$(awk '/^go /{print $2}' go.mod) &&
        if command -v mise >/dev/null; then mise x "go@$v" -- go build -o "$bin" ./cmd/sgnl-mcp-smoke; else go build -o "$bin" ./cmd/sgnl-mcp-smoke; fi)
    fi
    SGNL_SMOKE_URL="https://mcp.$SGNL_APPS_DOMAIN/mcp" SGNL_SMOKE_ISSUER="https://id.$SGNL_APPS_DOMAIN/realms/$SGNL_REALM" \
    SGNL_SMOKE_CLIENT_ID=sgnl-mcp-claude-code SGNL_SMOKE_A_USER=sgnl-smoke SGNL_SMOKE_B_USER=sgnl-smoke2 \
    SGNL_SMOKE_A_TOKEN="$ENVDIR/tokens/sgnl-smoke-token.json" SGNL_SMOKE_B_TOKEN="$ENVDIR/tokens/sgnl-smoke2-token.json" \
    SGNL_SMOKE_SHARED="smoke@$SGNL_DOMAIN" exec "$bin" -newsletter "$@" ;;   # dev: newsletter steps too (mail only to Mailpit)
  check)
    export NODE_EXTRA_CA_CERTS=$CAROOT/rootCA.pem
    : "${PLAYWRIGHT_CORE:=$(ls "$HOME"/Work/authelia/sgnl/e2e/browser/node_modules/playwright-core/index.mjs 2>/dev/null || echo playwright-core)}"
    export PLAYWRIGHT_CORE
    rc=0
    # Who gets what (seed): alice is an admin (admins, developers, forgejo_users), bob an ordinary user (no git
    # group), eve in no group: every app must refuse her.
    # One login at a time per person, at least a second apart (passkey sign count from the clock).
    for row in "alice admin admin admin admin admin admin" "bob user user refused user user user" \
               "eve refused refused refused refused refused refused"; do
      read -r u e1 e2 e3 e4 e5 e6 <<<"$row"; set -- $e1 $e2 $e3 $e4 $e5 $e6
      for app in inbox vault git listmonk monitor drive; do
        node host/dev/app-check.mjs $app "$u" "$SGNL_APPS_DOMAIN" "$ENVDIR/people" "$1" || rc=1; shift; sleep 2
      done
    done
    node host/dev/office-check.mjs alice "$SGNL_APPS_DOMAIN" "$ENVDIR/people" || rc=1
    exit $rc ;;
  inbound)
    shift; ca_bundle
    pw=$(mktemp); trap 'rm -f "$pw"' EXIT
    bin/sgnl-secret ses-relay-app-password > "$pw"
    RELAY_PASSWORD_FILE=$pw STALWART_HOST=mail.$SGNL_APPS_DOMAIN RELAY_USERNAME=ses-relay@$SGNL_DOMAIN \
      NODE_EXTRA_CA_CERTS=$CAROOT/rootCA.pem node host/dev/inbound.mjs "$@" ;;
  kamal)
    shift; secrets_file; ca_bundle
    exec bin/sgnl-env kamal "$@" -d dev ;;
  run)
    shift; secrets_file; ca_bundle
    exec bin/sgnl-env "$@" ;;
  hosts)
    hosts=""
    for h in id mail mcp drive office inbox vault git home monitor listmonk mailpit; do hosts+=" $h.$SGNL_APPS_DOMAIN"; done
    echo "127.0.0.1$hosts" ;;
  seed)
    secrets_file; ca_bundle
    export NODE_EXTRA_CA_CERTS=$CAROOT/rootCA.pem SGNL_NO_VAULT_SYNC=1   # no Vaultwarden in the spike
    : "${PLAYWRIGHT_CORE:=$(ls "$HOME"/Work/authelia/sgnl/e2e/browser/node_modules/playwright-core/index.mjs 2>/dev/null || echo playwright-core)}"
    export PLAYWRIGHT_CORE
    # username|display name|groups (sgnl_users always). Their mailboxes are in
    # instance.dev/stalwart/mailboxes.ndjson.
    for p in "alice|Alice Admin|admins developers forgejo_users mcp_users" "bob|Bob Example|mcp_users" \
             "sgnl-smoke|SGNL Smoke|mcp_users" "sgnl-smoke2|SGNL Smoke Two|mcp_users" \
             "eve|Eve Outsider|-"; do
      IFS='|' read -r u n g <<<"$p"
      [[ -s $ENVDIR/people/$u.passkey.json ]] && { echo "$u: already set up"; continue; }
      bin/sgnl-env bin/sgnl-id show "$u" >/dev/null 2>&1 || bin/sgnl-env bin/sgnl-id add-user "$u" "$n" >/dev/null
      # "-": an outsider in no group (bin/sgnl-dev check: every app must refuse her).
      # shellcheck disable=SC2086
      [[ $g == - ]] || bin/sgnl-env bin/sgnl-id add-to-group "$u" sgnl_users $g >/dev/null
      bin/sgnl-env bin/sgnl-id setup-email "$u" 2 >/dev/null
      sleep 2
      node host/dev/seed-person.mjs "$u" "$SGNL_DOMAIN" "$SGNL_APPS_DOMAIN" "$ENVDIR/people"
    done
    # Newsletters: listmonk accounts come from bin/sgnl-listmonk-sync (run by
    # bin/sgnl-id on group changes, as on a real instance); once more here.
    bin/sgnl-env bin/sgnl-listmonk-sync | tail -1
    # Git: the org + team Developers need the admin's account, which Forgejo
    # creates at the first sign-in.
    sleep 2
    node host/dev/app-check.mjs git "$SGNL_ADMIN_USER" "$SGNL_APPS_DOMAIN" "$ENVDIR/people" admin >/dev/null
    bin/sgnl-env bin/sgnl-forgejo-setup org | grep -v '^Delete the token'
    # The vault's organisation and the people in it, as on a real instance.
    sleep 2; bin/sgnl-dev vault ;;
  stop) limactl stop "$NAME" ;;
  start) limactl start "$NAME" ;;
  destroy)
    read -r -p "Delete VM $NAME and $ENVDIR (secrets, certificate, people)? type $NAME: " a
    [[ $a == "$NAME" ]] || { echo "not deleted"; exit 1; }
    limactl delete -f "$NAME"; rm -rf "${ENVDIR:?}"
    # The next VM gets a new host key on the same port.
    ssh-keygen -R "[127.0.0.1]:$PORT" -f "$STATE/known_hosts" >/dev/null 2>&1 || true
    echo "deleted $NAME (the dev CA in $CAROOT stays)" ;;
  *) sed -n 2,31p "$0"; exit 1 ;;
esac
