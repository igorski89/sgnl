#!/usr/bin/env python3
"""One-off (2026-11): copies the live SGNL secrets from the macOS Keychain
into Vaultwarden, folder "SGNL infra", one Login item each (name = the
Keychain service name, password = the value). The live list is LIVE in
bin/sgnl-breakglass-export. Items that already exist are compared, not
overwritten. Values go to bw over stdin, never on a command line; only
names and counts are printed.

  export BW_SESSION=$(bw unlock --raw)
  bin/sgnl-secrets-import-bw
"""
import base64, importlib.machinery, json, os, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FOLDER = "SGNL infra"
sys.path.insert(0, os.path.join(ROOT, "lib"))
import instance  # noqa: E402  (instance/sgnl.env)
PREFIX = instance.get("SGNL_PREFIX") + "-"

# LIVE (and its titles/notes) from the break-glass export.
src = open(os.path.join(ROOT, "bin/sgnl-breakglass-export")).read().replace("\nmain()\n", "\n")
ns = {}
exec(compile(src, "sgnl-breakglass-export", "exec"), ns)
LIVE = ns["LIVE"]


def bw(*args, stdin=None):
    r = subprocess.run(["bw", *args, "--nointeraction"], input=stdin, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit("bw " + args[0] + " failed: " + (r.stderr or r.stdout).strip()[-300:])
    return r.stdout


def keychain(name):
    return subprocess.run(["security", "find-generic-password", "-a", os.environ["USER"], "-s", name, "-w"],
                          check=True, capture_output=True, text=True).stdout.rstrip("\n")


def enc(obj):
    return base64.b64encode(json.dumps(obj).encode()).decode()


if not os.environ.get("BW_SESSION"):
    sys.exit("run first: export BW_SESSION=$(bw unlock --raw)")
bw("sync")
folders = [f for f in json.loads(bw("list", "folders")) if f["name"] == FOLDER]
folder_id = folders[0]["id"] if folders else json.loads(bw("create", "folder", stdin=enc({"name": FOLDER})))["id"]

existing = {}
for it in json.loads(bw("list", "items", "--search", PREFIX)):
    if it["name"].startswith(PREFIX) and it.get("type") == 1:
        existing.setdefault(it["name"], []).append(it)

created = same = differ = 0
for key, (title, url, notes) in LIVE.items():
    name = PREFIX + key
    value = keychain(name)
    if name in existing:
        vals = [(i.get("login") or {}).get("password") for i in existing[name]]
        if len(vals) == 1 and vals[0] == value:
            same += 1; print("same     " + name)
        else:
            differ += 1; print("DIFFERS  " + name + f" ({len(vals)} item(s)); left as is")
        continue
    item = {"type": 1, "name": name, "folderId": folder_id, "notes": f"{title}. {notes}",
            "login": {"username": name, "password": value, "uris": [{"uri": url, "match": None}]},
            "favorite": False, "reprompt": 0, "fields": [], "secureNote": None, "card": None, "identity": None}
    bw("create", "item", stdin=enc(item))
    created += 1; print("created  " + name)

print(f"{created} created, {same} already the same, {differ} differ (of {len(LIVE)})")
sys.exit(1 if differ else 0)
