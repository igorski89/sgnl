#!/usr/bin/env python3
"""Reads an OIDC client secret on stdin and prints the hash the login
server (Authelia) stores instead of the secret itself: PBKDF2-SHA512,
310000 rounds, random salt, Authelia's (passlib) format. A new salt each
run, so the hash changes on every deploy; the secret stays the same.
Printed base64-encoded: Kamal's .kamal/secrets (dotenv) would expand the
"$" in the hash as variables; the config decodes it (b64dec).
  bin/sgnl-secret keycloak-grafana-client-secret | bin/sgnl-client-secret-hash
"""
import base64, hashlib, os, sys
secret = sys.stdin.readline().rstrip("\n")
if not secret:
    sys.exit("no secret on stdin")
ab64 = lambda b: base64.b64encode(b).decode().rstrip("=").replace("+", ".")
salt = os.urandom(16)
key = hashlib.pbkdf2_hmac("sha512", secret.encode(), salt, 310000, 64)
h = f"$pbkdf2-sha512$310000${ab64(salt)}${ab64(key)}"
print(base64.b64encode(h.encode()).decode())
