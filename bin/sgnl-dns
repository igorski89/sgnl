#!/usr/bin/env python3
"""A records for app hosts under the apps domain, via the Cloudflare API
(DNS only, not proxied: kamal-proxy terminates TLS). Records docs/DNS.md
describes; update that table when you add a lasting one.

  bin/sgnl-dns list                 # A records under SGNL_APPS_DOMAIN
  bin/sgnl-dns add <name> [comment] # e.g. add files -> files.<apps> -> SGNL_HOST
  bin/sgnl-dns remove <name>

The token (vault item cloudflare-api-token, docs/DNS.md) stays in memory;
it's never on a command line.
"""
import json, os, subprocess, sys, urllib.error, urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))
import instance  # noqa: E402
I = instance.load()
APPS, HOST = I["SGNL_APPS_DOMAIN"], I["SGNL_HOST"]
API = "https://api.cloudflare.com/client/v4"


def token():
    r = subprocess.run([os.path.join(ROOT, "bin", "sgnl-secret"), "cloudflare-api-token"], capture_output=True, text=True)
    if r.returncode:
        sys.exit("sgnl-dns: " + r.stderr.strip())
    return r.stdout.strip()


TOKEN = None
def cf(method, path, body=None):
    global TOKEN
    TOKEN = TOKEN or token()
    req = urllib.request.Request(API + path, method=method, data=json.dumps(body).encode() if body else None,
                                 headers={"Authorization": "Bearer " + TOKEN, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req) as r:
            return json.load(r)["result"]
    except urllib.error.HTTPError as e:
        sys.exit(f"sgnl-dns: {method} {path} -> HTTP {e.code} {e.read().decode()[:300]}")


def zone():
    # The registrable domain: the last two labels of the apps domain.
    name = ".".join(APPS.split(".")[-2:])
    z = cf("GET", f"/zones?name={name}")
    if not z:
        sys.exit(f"sgnl-dns: no Cloudflare zone {name}")
    return z[0]["id"]


def fqdn(name):
    if not name or "." in name or not name.replace("-", "").isalnum():
        sys.exit(f"sgnl-dns: {name!r}: give the label only (e.g. auth, git-next)")
    return f"{name}.{APPS}"


def main(a):
    if len(a) == 1 and a[0] == "list":
        for r in sorted(cf("GET", f"/zones/{zone()}/dns_records?type=A&per_page=500"), key=lambda r: r["name"]):
            if r["name"].endswith("." + APPS):
                print(f'{r["name"]}\t{r["content"]}\t{"proxied" if r["proxied"] else "dns-only"}\t{r.get("comment") or ""}')
    elif len(a) in (2, 3) and a[0] == "add":
        n, z = fqdn(a[1]), zone()
        if cf("GET", f"/zones/{z}/dns_records?type=A&name={n}"):
            print(f"{n}: already exists"); return
        cf("POST", f"/zones/{z}/dns_records", {"type": "A", "name": n, "content": HOST, "ttl": 1,
                                               "proxied": False, "comment": a[2] if len(a) == 3 else "sgnl"})
        print(f"{n} -> {HOST} (DNS only): added")
    elif len(a) == 2 and a[0] == "remove":
        n, z = fqdn(a[1]), zone()
        recs = cf("GET", f"/zones/{z}/dns_records?type=A&name={n}")
        if not recs:
            print(f"{n}: not there"); return
        for r in recs:
            cf("DELETE", f"/zones/{z}/dns_records/{r['id']}")
        print(f"{n}: removed")
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
