#!/usr/bin/env bash
# Restore drill for Keycloak: restores the latest backup's pg_dump on the
# host and checks:
#   - the dump is in the backup and pg_restore loads it into a throwaway
#     Postgres (same image as live);
#   - a throwaway Keycloak (same image as live) boots on it (internal
#     network: no internet, no published ports);
#   - realm example is there with the same number of users, groups
#     and clients as live (live may be newer than the snapshot);
#   - the master admin can log in (password hashes intact) and the realm's
#     signing key ids equal live's (keys intact: apps keep trusting tokens).
# Cleans up after itself. See docs/BACKUPS.md. Run before every Keycloak
# or Postgres upgrade and before switching an app over.
#
#   bin/sgnl-backup-restore-test-keycloak [snapshot]   # default: latest
set -euo pipefail
source "$(dirname "$0")/../lib/instance.sh"

HOST=root@$SGNL_HOST
SNAPSHOT=${1:-latest}
pw=$("$(dirname "$0")/sgnl-secret" keycloak-bootstrap-admin-password)
# The live databases' first-start script (dbadmin + a normal app user):
# the throwaway one is set up the same way, and the dump is restored as
# the app user, as docs/RECOVERY.md does.
INITDB=$(base64 < "$(dirname "$0")/../postgres/initdb-app-user.sh" | tr -d '\n')

# stdin = the master admin password (first line, for kcadm; never argv),
# then the script itself.
{ printf '%s\n' "$pw"; cat <<'REMOTE'; } | ssh "$HOST" "export SNAPSHOT='$SNAPSHOT' SGNL_REALM='$SGNL_REALM' INITDB='$INITDB'; read -r KCPW; export KCPW; exec bash -s"
set -euo pipefail
B=/opt/sgnl/backup
T=$B/restore-test-keycloak
NAME=sgnl-restore-test-keycloak
cleanup() {
  docker rm -f $NAME $NAME-db >/dev/null 2>&1 || true
  docker network rm $NAME >/dev/null 2>&1 || true
  rm -rf "$T"
}
trap cleanup EXIT
cleanup

LIVE=$(docker ps -qf label=service=sgnl-keycloak -f label=role=web | head -1)
[[ -n $LIVE ]] || { echo "live Keycloak not running (needed for its image and for comparison)"; exit 1; }
IMAGE=$(docker inspect --format '{{.Config.Image}}' "$LIVE")
PGIMAGE=$(docker inspect --format '{{.Config.Image}}' sgnl-keycloak-postgres)

echo "==> restoring Keycloak's dump from snapshot $SNAPSHOT"
docker run --rm --env-file $B/restic.env -v $B/cache:/root/.cache/restic -v $B:/restore \
  restic/restic:0.19.1 restore "$SNAPSHOT" --host sgnl --target /restore/restore-test-keycloak \
  --include /staging/keycloak -q
DUMP=$T/staging/keycloak/keycloak.dump
[[ -s $DUMP ]] || { echo "MISSING in backup: keycloak/keycloak.dump"; exit 1; }
echo "    restored: $(du -h "$DUMP" | cut -f1)"

echo "==> loading it into a throwaway Postgres ($PGIMAGE)"
docker network create --internal $NAME >/dev/null
mkdir -p "$T" && base64 -d <<<"$INITDB" > "$T/90-app-user.sh" && chmod 755 "$T/90-app-user.sh"
docker run -d --name $NAME-db --network $NAME --network-alias db -e POSTGRES_USER=dbadmin \
  -e POSTGRES_DB=keycloak -e SGNL_DB_APP_USER=keycloak -e POSTGRES_PASSWORD=restore-test -v "$DUMP:/dump:ro" \
  -v "$T/90-app-user.sh:/docker-entrypoint-initdb.d/90-app-user.sh:ro" "$PGIMAGE" >/dev/null
for i in $(seq 1 30); do
  docker exec $NAME-db pg_isready -U dbadmin -q 2>/dev/null && break
  [[ $i == 30 ]] && { echo "throwaway Postgres never got ready"; exit 1; }
  sleep 2
done
# The image runs initdb + the first-start script on a temporary server,
# then restarts Postgres: wait for that, not just the first "ready".
for i in $(seq 1 60); do
  docker logs $NAME-db 2>&1 | grep -q "PostgreSQL init process complete" &&
    docker exec $NAME-db pg_isready -U dbadmin -q 2>/dev/null && break
  [[ $i == 60 ]] && { echo "throwaway Postgres never finished its first start"; docker logs --tail 5 $NAME-db; exit 1; }
  sleep 1
done
docker exec $NAME-db pg_restore -U keycloak -d keycloak --clean --if-exists --no-owner /dump
echo "    pg_restore: ok"

echo "==> booting a throwaway Keycloak on it (no internet, no ports)"
docker run -d --name $NAME --network $NAME --memory 1280m \
  -e KC_DB_URL=jdbc:postgresql://db:5432/keycloak -e KC_DB_USERNAME=keycloak -e KC_DB_PASSWORD=restore-test \
  -e KC_HOSTNAME=http://localhost:8080 -e KC_HTTP_ENABLED=true -e KC_CACHE=local "$IMAGE" >/dev/null
for i in $(seq 1 60); do
  docker exec $NAME bash -c 'exec 3<>/dev/tcp/localhost/8080 && printf "GET /realms/'"$SGNL_REALM"' HTTP/1.0\r\n\r\n" >&3 && head -1 <&3' 2>/dev/null | grep -q 200 && break
  [[ $i == 60 ]] && { echo "restored Keycloak never served the realm"; docker logs --tail 30 $NAME; exit 1; }
  sleep 2
done
echo "    realm $SGNL_REALM: served"

kcadm() { # $1 = container; rest = kcadm args (logged in as the master admin)
  local c=$1; shift
  printf '%s\n' "$KCPW" | docker exec -i "$c" bash -c 'read -r P; export HOME=$(mktemp -d)
    /opt/keycloak/bin/kcadm.sh config credentials --server http://localhost:8080 --realm master --user admin --password "$P" >/dev/null 2>&1 || { echo LOGIN-FAILED; exit 1; }
    exec /opt/keycloak/bin/kcadm.sh "$@"' _ "$@"
}
count() { kcadm "$1" get "$2" -r "$SGNL_REALM" --fields id -q max=1000 2>/dev/null | grep -c '"id"'; }
kids() { kcadm "$1" get keys -r "$SGNL_REALM" 2>/dev/null | grep -o '"kid" : "[^"]*"' | sort | tr -d '\n'; }

kcadm $NAME get "realms/$SGNL_REALM" --fields realm >/dev/null || { echo "==> restore test FAILED: master admin can't log in"; exit 1; }
echo "    master admin login: ok"
echo "    counts (restored | live; live may be newer than the snapshot):"
for what in users groups clients; do
  printf '    %-8s %4s | %s\n' "$what" "$(count $NAME $what)" "$(count $LIVE $what)"
done
if [[ $(kids $NAME) == "$(kids $LIVE)" ]]; then
  echo "    signing keys: same key ids as live"
else
  echo "==> restore test FAILED: realm keys differ from live (tokens would stop validating)"; exit 1
fi
echo "==> restore test OK (scratch copy removed)"
REMOTE
