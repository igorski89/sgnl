#!/usr/bin/env bash
# Automated login matrix (instance/docs/PLAN-authelia-test.md): a headless
# Chromium with a virtual passkey logs in to each app copy
# (bin/sgnl-authelia-matrix up <app>) as matrix-user and matrix-admin
# through the test Authelia, and checks what the app made of them
# (role/admin, account refused where live refuses it).
#
#   bin/sgnl-authelia-matrix-test grafana forgejo listmonk vaultwarden dashy
#
# Needs Playwright: python3 -m venv ~/.cache/sgnl/matrix/venv &&
#   ~/.cache/sgnl/matrix/venv/bin/pip install playwright &&
#   ~/.cache/sgnl/matrix/venv/bin/playwright install chromium
# The test users' virtual passkeys (test-only keys) are kept in
# ~/.cache/sgnl/matrix/passkey-*.json, so registration (which needs a
# one-time code, rate-limited by Authelia) happens once per user.
# Screenshots of the last run: ~/.cache/sgnl/matrix/shots/.
set -euo pipefail
cd "$(dirname "$0")/.."
source lib/instance.sh
export APPS=$SGNL_APPS_DOMAIN REALM=$SGNL_REALM DOMAIN=$SGNL_DOMAIN SGNL_HOST SHOTS=$HOME/.cache/sgnl/matrix/shots
mkdir -p "$SHOTS"
PW_MATRIX_USER=$(bin/sgnl-secret authelia-test-matrix-user-password)
PW_MATRIX_ADMIN=$(bin/sgnl-secret authelia-test-matrix-admin-password)
export PW_MATRIX_USER PW_MATRIX_ADMIN
exec "${SGNL_MATRIX_PYTHON:-$HOME/.cache/sgnl/matrix/venv/bin/python}" tests/authelia-matrix/matrix_test.py "$@"
