#!/usr/bin/env bash
# Login matrix for the Authelia fork (instance/docs/PLAN-authelia-test.md):
# throwaway copies of SGNL's apps that log in through the TEST Authelia
# (auth.<apps>, config/deploy.authelia.yml). Each copy: the live app's
# pinned image, fresh empty data, host <app>-next.<apps> (DNS record via
# bin/sgnl-dns, TLS by kamal-proxy). Nothing live is touched.
#
#   bin/sgnl-authelia-matrix up <app>      # DNS, container, route (+ app setup)
#   bin/sgnl-authelia-matrix down <app>    # remove container, volume, route, DNS
#   bin/sgnl-authelia-matrix status
#
# Apps: grafana vaultwarden forgejo listmonk dashy. Each app's client is in
# authelia/configuration.yml (deployed first); its secret is the vault
# item authelia-test-<app>-client-secret (none for dashy: public client).
# Secrets reach the server on ssh stdin, into an env file in memory.
set -euo pipefail
source "$(dirname "$0")/../lib/instance.sh"
cd "$(dirname "$0")/.."
HOST=root@$SGNL_HOST
ISSUER="https://auth.$SGNL_APPS_DOMAIN/realms/$SGNL_REALM"
APPS="grafana vaultwarden forgejo listmonk dashy opencloud"

usage() { sed -n '2,16p' "$0"; exit 1; }
mode=${1:-}; app=${2:-}
[[ $mode == status ]] || [[ " $APPS " == *" $app "* ]] || usage
c="sgnl-matrix-$app"
cmd=() secret_var="" file_target="" entry="" extra_vols=""
# file_target: "name:/path ..." -> file_<app>_<name> is mounted at /path.

# Per app: label (host <label>.<apps>), port, image, data dir, secret
# variable, environment (stdout), optional setup after start.
base_image() { grep -h '^FROM' "docker/$1/Dockerfile" | head -1 | awk '{print $2}'; }
case $app in
  grafana)
    label=monitor-next port=3000 image=$(base_image grafana) data=/var/lib/grafana health=/api/health
    secret_var=GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET ;;
  vaultwarden)
    label=vault-next port=80 image=$(base_image vaultwarden) data=/data health=/alive
    secret_var=SSO_CLIENT_SECRET ;;
  forgejo)
    label=git-next port=3000 image=$(base_image forgejo) data=/var/lib/gitea health=/api/healthz ;;
  listmonk)
    # Our fork's image as it runs live (built by Kamal from the git tag).
    label=listmonk-next port=9000 data=/listmonk/data health=/health
    image=$(ssh "$HOST" "docker inspect --format '{{.Config.Image}}' \$(docker ps -qf label=service=sgnl-listmonk -f label=role=web | head -1)")
    secret_var=LISTMONK_ADMIN_PASSWORD
    file_target=run:/matrix-run.sh cmd=(sh /matrix-run.sh) ;;
  dashy)
    label=home-next port=8080 image=lissy93/dashy:4.9.19 data=/app/user-data/data health=/
    file_target=conf:/app/user-data/conf.yml ;;
  opencloud)
    label=drive-next port=9200 image=$(base_image opencloud) data=/var/lib/opencloud health=/status.php
    extra_vols="-v ${c}_config:/etc/opencloud"
    entry=/bin/sh cmd=(/matrix-run.sh)
    file_target="run:/matrix-run.sh proxy:/etc/opencloud/proxy.yaml" ;;
esac
url="https://${label:-}.$SGNL_APPS_DOMAIN"

env_grafana() { cat <<EOF
GF_SERVER_ROOT_URL=$url
GF_AUTH_BASIC_ENABLED=false
GF_AUTH_DISABLE_LOGIN_FORM=true
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=SGNL (Authelia test)
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=grafana
GF_AUTH_GENERIC_OAUTH_SCOPES=openid email profile groups
GF_AUTH_GENERIC_OAUTH_AUTH_URL=$ISSUER/api/oidc/authorization
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=$ISSUER/api/oidc/token
GF_AUTH_GENERIC_OAUTH_API_URL=$ISSUER/api/oidc/userinfo
GF_AUTH_GENERIC_OAUTH_AUTH_STYLE=InHeader
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=name
GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH=groups
GF_AUTH_GENERIC_OAUTH_ALLOWED_GROUPS=sgnl_users
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'admins') && 'Admin' || 'Viewer'
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=false
EOF
}

# As config/deploy.vaultwarden.yml, pointed at the test issuer.
env_vaultwarden() { cat <<EOF
DOMAIN=$url
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=false
SHOW_PASSWORD_HINT=false
PASSWORD_HINTS_ALLOWED=false
EMAIL_CHANGE_ALLOWED=false
ENABLE_DB_WAL=true
SSO_ENABLED=true
SSO_ONLY=true
SSO_SIGNUPS_MATCH_EMAIL=true
SSO_AUTH_ONLY_NOT_SESSION=true
SSO_AUTHORITY=$ISSUER
SSO_CLIENT_ID=vaultwarden
SSO_SCOPES=email profile
SSO_PKCE=true
EOF
}

# As config/deploy.forgejo.yml (without mail); the auth source is added
# after start (setup_forgejo), as bin/sgnl-forgejo-setup does live.
env_forgejo() { cat <<EOF
FORGEJO__DEFAULT__APP_NAME=SGNL Git (Authelia test)
FORGEJO__security__INSTALL_LOCK=true
FORGEJO__database__DB_TYPE=sqlite3
FORGEJO__database__PATH=/var/lib/gitea/data/forgejo.db
FORGEJO__server__DOMAIN=$label.$SGNL_APPS_DOMAIN
FORGEJO__server__ROOT_URL=$url/
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__DISABLE_SSH=true
FORGEJO__server__START_SSH_SERVER=false
FORGEJO__service__DISABLE_REGISTRATION=false
FORGEJO__service__ALLOW_ONLY_EXTERNAL_REGISTRATION=true
FORGEJO__service__SHOW_REGISTRATION_BUTTON=false
FORGEJO__service__ENABLE_INTERNAL_SIGNIN=false
FORGEJO__service__REQUIRE_SIGNIN_VIEW=true
FORGEJO__oauth2_client__ENABLE_AUTO_REGISTRATION=true
FORGEJO__oauth2_client__USERNAME=email
FORGEJO__oauth2_client__ACCOUNT_LINKING=disabled
FORGEJO__oauth2_client__REGISTER_EMAIL_CONFIRM=false
FORGEJO__openid__ENABLE_OPENID_SIGNIN=false
FORGEJO__openid__ENABLE_OPENID_SIGNUP=false
FORGEJO__actions__ENABLED=false
FORGEJO__mailer__ENABLED=false
EOF
}
setup_forgejo() {
  bin/sgnl-secret authelia-test-forgejo-client-secret |
    ssh "$HOST" "for i in \$(seq 1 30); do docker exec $c forgejo admin auth list >/dev/null 2>&1 && break; sleep 2; done
      docker exec -i $c sh -c 'read -r S; exec forgejo admin auth add-oauth --name authelia --provider openidConnect \
        --key forgejo --secret \"\$S\" \
        --auto-discover-url $ISSUER/.well-known/openid-configuration \
        --scopes openid --scopes profile --scopes email --scopes groups \
        --skip-local-2fa --group-claim-name groups --admin-group admins' && docker restart $c >/dev/null && echo 'forgejo: auth source added'"
}

# Our listmonk fork: admin user = matrix-admin (password: the client
# secret var, break-glass only), OIDC settings as bin/sgnl-listmonk-setup.
env_listmonk() { cat <<EOF
LISTMONK_app__address=0.0.0.0:9000
LISTMONK_db__driver=sqlite
LISTMONK_db__path=/listmonk/data/listmonk.db
LISTMONK_ADMIN_USER=matrix-admin
EOF
}
setup_listmonk() {
  { bin/sgnl-secret authelia-test-listmonk-client-secret; echo; } | python3 -c '
import json, sys
s = sys.stdin.readline().strip()
q = lambda v: "'"'"'" + v.replace("'"'"'", "'"'"''"'"'") + "'"'"'"
import os
url, iss, dom = sys.argv[1], sys.argv[2], sys.argv[3]
oidc = {"enabled": True, "provider_url": iss, "redirect_url": url + "/auth/oidc", "provider_name": "SGNL (Authelia test)",
        "client_id": "listmonk", "client_secret": s, "auto_create_users": False, "verify_email": False, "auto_login": True}
print(".bail on\n.timeout 10000\nBEGIN;")
print("UPDATE settings SET value = json_quote(%s) WHERE key = %s;" % (q(url), q("app.root_url")))
print("UPDATE settings SET value = json_patch(value, %s) WHERE key = %s;" % (q(json.dumps(oidc)), q("security.oidc")))
print("UPDATE users SET email = %s WHERE username = %s;" % (q("matrix-admin@" + dom), q("matrix-admin")))
print("COMMIT;")' "$url" "$ISSUER" "$SGNL_DOMAIN" |
    ssh "$HOST" "for i in \$(seq 1 30); do docker exec $c test -s /listmonk/data/listmonk.db && docker exec $c sqlite3 /listmonk/data/listmonk.db 'select 1 from users limit 1' >/dev/null 2>&1 && break; sleep 2; done
      docker exec -i $c sqlite3 /listmonk/data/listmonk.db && docker restart $c >/dev/null && echo 'listmonk: OIDC set, admin = matrix-admin'"
}

# Dashy: a public client; minimal page with the live auth block.
env_dashy() { echo "NODE_ENV=production"; }
file_listmonk_run() { cat <<'EOF'
./listmonk --install --idempotent --yes --config '' && ./listmonk --upgrade --yes --config '' && exec ./listmonk --config ''
EOF
}
file_dashy_conf() { cat <<EOF
pageInfo:
  title: SGNL (Authelia test)
appConfig:
  hideSettings: true
  auth:
    enableOidc: true
    oidc:
      clientId: dashy
      endpoint: $ISSUER
      adminGroup: admins
      scope: openid profile email groups
sections:
  - name: Test
    items:
      - title: Authelia
        url: $ISSUER
EOF
}

# OpenCloud: as config/deploy.opencloud.yml (web client only, no office,
# no mail), pointed at the test issuer; init on first start, as live.
env_opencloud() { cat <<EOF
OC_URL=$url
OC_LOG_LEVEL=info
PROXY_TLS=false
OC_INSECURE=false
PROXY_ENABLE_BASIC_AUTH=false
IDM_CREATE_DEMO_USERS=false
OC_OIDC_ISSUER=$ISSUER
OC_EXCLUDE_RUN_SERVICES=idp
PROXY_OIDC_ACCESS_TOKEN_VERIFY_METHOD=jwt
PROXY_OIDC_REWRITE_WELLKNOWN=true
PROXY_AUTOPROVISION_ACCOUNTS=true
PROXY_AUTOPROVISION_CLAIM_USERNAME=preferred_username
PROXY_AUTOPROVISION_CLAIM_EMAIL=email
PROXY_AUTOPROVISION_CLAIM_DISPLAYNAME=name
PROXY_AUTOPROVISION_CLAIM_GROUPS=groups
PROXY_ROLE_ASSIGNMENT_DRIVER=oidc
GRAPH_ASSIGN_DEFAULT_USER_ROLE=false
PROXY_CONFIG_FILE=/etc/opencloud/proxy.yaml
WEB_OIDC_CLIENT_ID=opencloud
WEB_OIDC_SCOPE=openid profile email groups
WEBFINGER_WEB_OIDC_CLIENT_ID=opencloud
WEBFINGER_WEB_OIDC_CLIENT_SCOPES=openid profile email groups
EOF
}
file_opencloud_run() { echo 'opencloud init --insecure no >/dev/null 2>&1 || true; exec opencloud server'; }
file_opencloud_proxy() { cat opencloud/proxy.yaml; }

up() {
  bin/sgnl-dns add "$label" "Authelia login matrix (test copy of $app)"
  local env; env=$("env_$app")
  local extra_mount="" conf=""
  local ft n t
  for ft in $file_target; do
    n=${ft%%:*} t=${ft#*:}
    conf+="install -d /opt/sgnl/matrix/$app; echo $("file_${app}_$n" | base64 | tr -d '\n') | base64 -d > /opt/sgnl/matrix/$app/$n; chmod 644 /opt/sgnl/matrix/$app/$n; "
    extra_mount+=" -v /opt/sgnl/matrix/$app/$n:$t:ro"
  done
  local qcmd="${cmd[*]:-}"   # plain words only (no quotes): passed through two shells
  # stdin: line 1 the secret (may be empty), then the env lines.
  { [[ -n $secret_var ]] && bin/sgnl-secret "authelia-test-$app-client-secret"; echo; printf '%s\n' "$env"; } |
    ssh "$HOST" "bash -c 'set -e
      read -r S; E=\$(cat)
      $conf
      docker rm -f $c >/dev/null 2>&1 || true
      docker run -d --name $c --network kamal --restart unless-stopped --label sgnl.matrix=1 \
        -v ${c}_data:$data $extra_vols $extra_mount ${entry:+--entrypoint $entry} \
        --env-file <(printf \"%s\n\" \"\$E\"; [ -n \"$secret_var\" ] && printf \"%s=%s\n\" $secret_var \"\$S\") $image $qcmd >/dev/null
      docker exec kamal-proxy kamal-proxy deploy $c --target $c:$port --host $label.$SGNL_APPS_DOMAIN --tls \
        --health-check-path $health --deploy-timeout 180s >/dev/null
      echo up: $c'"
  if declare -F "setup_$app" >/dev/null; then "setup_$app"; fi
  echo "$url (log in as matrix-user / matrix-admin; passwords: bin/sgnl-secret authelia-test-matrix-<user>-password)"
}

down() {
  ssh "$HOST" "docker exec kamal-proxy kamal-proxy remove $c 2>/dev/null || true
    docker rm -f $c >/dev/null 2>&1 || true
    docker volume rm ${c}_data ${c}_config >/dev/null 2>&1 || true
    rm -rf /opt/sgnl/matrix/$app
    echo down: $c"
  bin/sgnl-dns remove "$label"
}

case $mode in
  up) up ;;
  down) down ;;
  status) ssh "$HOST" "docker ps -a --filter label=sgnl.matrix=1 --format '{{.Names}}\t{{.Status}}'" ;;
  *) usage ;;
esac
