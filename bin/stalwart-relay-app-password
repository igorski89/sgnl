#!/usr/bin/env bash
# Create (or rotate) the app password the SES forwarder Lambda uses to log
# in as ses-relay@example.com, store it in the vault and copy it
# into AWS Secrets Manager. Never prints the secret.
#
# Why an app password: Stalwart's directory is Keycloak (OIDC, set in
# stalwart/plan-oidc.ndjson). With an external directory, an account's
# plain password is never checked (454) and can't be set ("Cannot set
# credentials for accounts in an external directory"). App passwords are
# checked against Stalwart's own store first, so they keep working while
# the IdP is down (tested 2026-10-08 with Authelia, then the IdP,
# including a Stalwart restart with it stopped).
#
# Admins can't create another account's app password directly, so this
# logs in as "ses-relay@...%admin" (recovery-admin impersonation), briefly
# grants the relay the sysAppPassword* permissions, and always restores its
# least-privilege set (authenticate + emailSend) on exit.
#
# Usage: bin/stalwart-relay-app-password      (STALWART_URL as in bin/stalwart-apply)
set -euo pipefail
source "$(dirname "$0")/../lib/instance.sh"
cd "$(dirname "$0")/.."

source "${SECRETS_FILE:-.kamal/secrets}"
export STALWART_URL=${STALWART_URL:-https://mail.$SGNL_APPS_DOMAIN}
ADMIN=${STALWART_RECOVERY_ADMIN%%:*}
export STALWART_PASSWORD=${STALWART_RECOVERY_ADMIN#*:}
RELAY=ses-relay@$SGNL_DOMAIN
ITEM=$SGNL_PREFIX-ses-relay-app-password
DESC="SES forwarder Lambda"

as_admin() { STALWART_USER=$ADMIN stalwart-cli "$@"; }
as_relay() { STALWART_USER="$RELAY%$ADMIN" stalwart-cli "$@"; }

relay_id=$(as_admin query Account | awk -v a="$RELAY" '$2==a {print $1}')
[[ -n $relay_id ]] || { echo "account $RELAY not found - run bin/stalwart-apply first" >&2; exit 1; }

set_perms() {
  as_admin update Account "$relay_id" --json "{\"permissions\":{\"@type\":\"Replace\",\"enabledPermissions\":{\"authenticate\":true,\"emailSend\":true$1},\"disabledPermissions\":{}}}" >/dev/null
}
set_perms ',"sysAppPasswordCreate":true,"sysAppPasswordQuery":true,"sysAppPasswordGet":true,"sysAppPasswordDestroy":true'
trap 'set_perms ""; echo "relay permissions restored (authenticate, emailSend)"' EXIT

old=$(as_relay query AppPassword | awk -v d="$DESC" 'NR>1 && index($0,d) {print $1}' | paste -sd, -)
out=$(as_relay create AppPassword --json "{\"description\":\"$DESC\"}")
secret=$(awk '/Secret:/{print $2}' <<<"$out")
[[ ${#secret} -ge 20 ]] || { echo "could not read the new app password from stalwart-cli output" >&2; exit 1; }
printf '%s' "$secret" | bin/sgnl-secret --set "$ITEM"
echo "new app password stored as $ITEM (bin/sgnl-secret)"

# Hand it to the Lambda. Runs before the old one is deleted, so mail
# keeps flowing during a rotation.
(cd aws && ./awscli secretsmanager put-secret-value --region eu-central-1 \
   --secret-id "$(./tf output -raw relay_secret_arn)" --secret-string "$secret" \
   --query Name --output text)
unset secret out

if [[ -n $old ]]; then
  as_relay delete AppPassword --ids "$old" >/dev/null
  echo "deleted previous app password(s): $old"
fi
