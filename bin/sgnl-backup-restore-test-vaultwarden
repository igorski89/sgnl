#!/usr/bin/env bash
# Restore drill for Vaultwarden: restores the latest backup's Vaultwarden
# volume on the host into a scratch dir and checks:
#   - the database and the RSA key (signs login tokens) are in the backup;
#   - SQLite integrity_check passes on the restored database;
#   - row counts (users, items, folders, orgs, devices, sends, attachments)
#     next to the live database's, read-only;
#   - a throwaway Vaultwarden boots on it (internal network: no internet,
#     no published ports), answers /alive, and reuses the restored RSA key
#     instead of creating a new one.
# The vault items are end-to-end encrypted with each person's master
# password, so this can't prove they decrypt; that needs a person logging
# in to a restored copy. Cleans up after itself. See docs/BACKUPS.md.
#
#   bin/sgnl-backup-restore-test-vaultwarden [snapshot]   # default: latest
set -euo pipefail
source "$(dirname "$0")/../lib/instance.sh"

HOST=root@$SGNL_HOST
SNAPSHOT=${1:-latest}

ssh "$HOST" "export SNAPSHOT='$SNAPSHOT' SGNL_APPS_DOMAIN='$SGNL_APPS_DOMAIN'; exec bash -s" <<'REMOTE'
set -euo pipefail
B=/opt/sgnl/backup
T=$B/restore-test-vaultwarden
NAME=sgnl-restore-test-vaultwarden
DATA=$T/staging/sgnl_vaultwarden_data
cleanup() {
  docker rm -f $NAME >/dev/null 2>&1 || true
  docker network rm $NAME >/dev/null 2>&1 || true
  rm -rf "$T"
}
trap cleanup EXIT
cleanup

LIVE=$(docker ps -qf label=service=sgnl-vaultwarden | head -1)
[[ -n $LIVE ]] || { echo "live Vaultwarden not running (needed for its image and for comparison)"; exit 1; }
IMAGE=$(docker inspect --format '{{.Config.Image}}' "$LIVE")
LIVEDATA=$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Source}}{{end}}{{end}}' "$LIVE")

echo "==> restoring Vaultwarden from snapshot $SNAPSHOT"
docker run --rm --env-file $B/restic.env -v $B/cache:/root/.cache/restic -v $B:/restore \
  restic/restic:0.18.0 restore "$SNAPSHOT" --host sgnl --target /restore/restore-test-vaultwarden \
  --include /staging/sgnl_vaultwarden_data -q
for f in db.sqlite3 rsa_key.pem; do
  [[ -s $DATA/$f ]] || { echo "MISSING in backup: $f"; exit 1; }
done
echo "    restored: $(du -sh "$DATA" | cut -f1) (db.sqlite3, rsa_key.pem present)"

# sqlite3 isn't in the Vaultwarden image or on the host: a throwaway
# Alpine with it (needs the internet only for apk), files mounted read-only.
# The live database is opened read-only via a copy, never in place.
LIVECOPY=$T/live-copy; mkdir -p "$LIVECOPY"
cp "$LIVEDATA"/db.sqlite3* "$LIVECOPY"/
cat > "$LIVECOPY/q.sql" <<'SQLQ'
select 'users', count(*) from users;
select 'items', count(*) from ciphers;
select 'folders', count(*) from folders;
select 'organizations', count(*) from organizations;
select 'devices', count(*) from devices;
select 'sends', count(*) from sends;
select 'attachments', count(*) from attachments;
SQLQ
SQL=$(docker run --rm -v "$DATA:/r:ro" -v "$LIVECOPY:/l" alpine:3.20 sh -c '
  apk add -q sqlite >/dev/null 2>&1
  cp /r/db.sqlite3* /tmp/ 2>/dev/null; echo integrity=$(sqlite3 /tmp/db.sqlite3 "pragma integrity_check;")
  echo --restored; sqlite3 -separator " " /tmp/db.sqlite3 < /l/q.sql
  echo --live; sqlite3 -separator " " /l/db.sqlite3 < /l/q.sql')
echo "==> SQLite: $(echo "$SQL" | sed -n 's/^integrity=//p')"
echo "    counts (restored | live; live may be newer than the snapshot):"
paste <(echo "$SQL" | sed -n '/^--restored/,/^--live/p' | grep -v '^--') \
      <(echo "$SQL" | sed -n '/^--live/,$p' | grep -v '^--') | awk '{printf "    %-14s %5s | %s\n", $1, $2, $4}'
echo "$SQL" | grep -q '^integrity=ok$' || { echo "==> restore test FAILED: integrity check"; exit 1; }

echo "==> booting a throwaway Vaultwarden on it (no internet, no ports)"
docker network create --internal $NAME >/dev/null
docker run -d --name $NAME --network $NAME -v "$DATA:/data" \
  -e DOMAIN=https://vault.$SGNL_APPS_DOMAIN -e SIGNUPS_ALLOWED=false "$IMAGE" >/dev/null
for i in $(seq 1 30); do
  docker exec $NAME curl -fsS http://localhost:80/alive >/dev/null 2>&1 && break
  [[ $i == 30 ]] && { echo "restored Vaultwarden never answered /alive"; docker logs --tail 30 $NAME; exit 1; }
  sleep 2
done
echo "    /alive: ok"
if docker logs $NAME 2>&1 | grep -q "rsa_key.pem' created"; then
  echo "==> restore test FAILED: Vaultwarden created a new RSA key (restored one not used)"; exit 1
fi
echo "    reused the restored RSA key (no new key created)"
echo "==> restore test OK (scratch copy removed)"
REMOTE
