#!/usr/bin/env python3
"""listmonk settings that live in its database, as code. Idempotent; run
after `kamal setup -c config/deploy.listmonk.yml` and whenever these change.

  bin/sgnl-listmonk-setup

Sets:
  app.root_url     https://listmonk.<SGNL_APPS_DOMAIN>
  security.oidc    Keycloak login (client "listmonk", keycloak/realm.yaml);
                   no auto-created accounts: Keycloak users log in to the
                   listmonk account with the same email
  the super admin  (LISTMONK_ADMIN_USER = SGNL_ADMIN_USER) gets the email
                   <SGNL_ADMIN_USER>@<SGNL_DOMAIN>, so that person's
                   Keycloak login opens it
  app.from_email   "<SGNL_ORG_NAME> <campaigns@<SGNL_DOMAIN>>" (replies land
                   in the domain's catch-all)
  smtp             one server: SES (SGNL_SMTP_HOST:587, STARTTLS, the
                   ses-smtp-* credentials), header X-SES-CONFIGURATION-SET:
                   <prefix>-campaigns (aws/campaigns.tf)
  bounce.*         processing on, SES webhook on and limited to our SNS topic
                   (Terraform output campaigns_events_topic_arn); hard bounce
                   or complaint -> blocklist, 2 soft bounces -> nothing
                   (Amazon's advice)
then restarts listmonk, which reads settings at start. SMTP changes made
in listmonk's UI are overwritten by the next run: change them here.

Written for listmonk 7 (from_email is a list, bounce.ses an object).
Values are merged into the stored JSON (keys listmonk adds in later
versions are kept). SQL goes to psql on stdin over SSH, so secrets are
never on a command line.
"""
import json, os, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))
import instance  # noqa: E402
I = instance.load()
HOST, APPS, DOMAIN, REALM, ADMIN = (I["SGNL_HOST"], I["SGNL_APPS_DOMAIN"], I["SGNL_DOMAIN"],
                                    I["SGNL_REALM"], I["SGNL_ADMIN_USER"])
# Sending: SES SMTP, every message tagged with the configuration set that
# routes its bounces/complaints back to listmonk (aws/campaigns.tf).
FROM = f'{I["SGNL_ORG_NAME"]} <campaigns@{DOMAIN}>'
CONFIG_SET = I["SGNL_PREFIX"] + "-campaigns"


def secret(name):
    r = subprocess.run([os.path.join(ROOT, "bin", "sgnl-secret"), name], capture_output=True, text=True)
    if r.returncode:
        sys.exit("sgnl-listmonk-setup: " + r.stderr.strip())
    return r.stdout


def topic_arn():
    """The SNS topic SES publishes campaign bounces/complaints to (aws/campaigns.tf)."""
    r = subprocess.run(["./tf", "output", "-raw", "campaigns_events_topic_arn"], cwd=os.path.join(ROOT, "aws"),
                       capture_output=True, text=True)
    if r.returncode or not r.stdout.startswith("arn:aws:sns:"):
        sys.exit("sgnl-listmonk-setup: no Terraform output campaigns_events_topic_arn (./tf apply in aws/ first)")
    return r.stdout.strip()


def q(s):
    """A SQL literal: dollar-quoted, so JSON and secrets need no escaping."""
    tag = "$sgnl$"
    if tag in s:
        sys.exit("sgnl-listmonk-setup: value contains the quoting tag")
    return f"{tag}{s}{tag}"


oidc = {"enabled": True, "provider_url": f"https://id.{APPS}/realms/{REALM}",
        "redirect_url": f"https://listmonk.{APPS}/auth/oidc",
        "provider_name": "SGNL", "client_id": "listmonk",
        "client_secret": secret("keycloak-listmonk-client-secret"),
        "auto_create_users": False}
smtp = [{"enabled": True, "host": I["SGNL_SMTP_HOST"], "port": 587, "auth_protocol": "login",
         "username": secret("ses-smtp-username"), "password": secret("ses-smtp-password"),
         "hello_hostname": f"listmonk.{APPS}", "max_conns": 5, "idle_timeout": "15s",
         "wait_timeout": "5s", "max_msg_retries": 2, "msg_retry_delay": "10ms",
         "tls_type": "STARTTLS", "tls_skip_verify": False,
         "email_headers": [{"X-SES-CONFIGURATION-SET": CONFIG_SET}], "from_addresses": []}]
bounce_actions = {"soft": {"count": 2, "action": "none"}, "hard": {"count": 1, "action": "blocklist"},
                  "complaint": {"count": 1, "action": "blocklist"}}
sql = f"""\\set ON_ERROR_STOP on
BEGIN;
UPDATE settings SET value = to_jsonb({q(f"https://listmonk.{APPS}")}::text), updated_at = NOW()
  WHERE key = 'app.root_url';
UPDATE settings SET value = value || {q(json.dumps(oidc))}::jsonb, updated_at = NOW()
  WHERE key = 'security.oidc';
UPDATE settings SET value = jsonb_build_array({q(FROM)}::text), updated_at = NOW() WHERE key = 'app.from_email';
UPDATE settings SET value = {q(json.dumps(smtp))}::jsonb, updated_at = NOW() WHERE key = 'smtp';
UPDATE settings SET value = 'true'::jsonb, updated_at = NOW()
  WHERE key IN ('bounce.enabled', 'bounce.webhooks_enabled');
UPDATE settings SET value = value || {q(json.dumps({"enabled": True, "topic_arns": [topic_arn()]}))}::jsonb, updated_at = NOW()
  WHERE key = 'bounce.ses';
UPDATE settings SET value = {q(json.dumps(bounce_actions))}::jsonb, updated_at = NOW() WHERE key = 'bounce.actions';
UPDATE users SET email = {q(f"{ADMIN}@{DOMAIN}")}, updated_at = NOW()
  WHERE username = {q(ADMIN)} AND email IS DISTINCT FROM {q(f"{ADMIN}@{DOMAIN}")};
SELECT 'root_url ' || (SELECT value #>> '{{}}' FROM settings WHERE key = 'app.root_url');
SELECT 'oidc ' || (SELECT (value->>'enabled') || ' ' || (value->>'provider_url') FROM settings WHERE key = 'security.oidc');
SELECT 'from ' || (SELECT value->>0 FROM settings WHERE key = 'app.from_email');
SELECT 'smtp ' || (SELECT string_agg((e->>'host') || ':' || (e->>'port') || ' ' || (e->>'enabled'), ', ') FROM settings, jsonb_array_elements(value) e WHERE key = 'smtp');
SELECT 'bounces ' || (SELECT string_agg(key || '=' || (value #>> '{{}}'), ' ' ORDER BY key) FROM settings WHERE key IN ('bounce.enabled', 'bounce.webhooks_enabled'))
  || ' ses=' || (SELECT (value->>'enabled') || ' topics=' || jsonb_array_length(value->'topic_arns') FROM settings WHERE key = 'bounce.ses');
SELECT 'admin ' || username || ' <' || email || '>' FROM users WHERE username = {q(ADMIN)};
COMMIT;
"""
remote = ("set -e; docker exec -i sgnl-listmonk-postgres psql -q -t -A -U listmonk -d listmonk; "
          "c=$(docker ps -q --filter name='^sgnl-listmonk-web$'); "
          "[ -n \"$c\" ] && docker restart $c >/dev/null && echo restarted listmonk")
r = subprocess.run(["ssh", f"root@{HOST}", remote], input=sql, text=True, capture_output=True)
print(r.stdout.strip())
if r.returncode:
    sys.exit("sgnl-listmonk-setup: " + r.stderr.strip()[-400:])
