#!/usr/bin/env bash
# Unlocks Vaultwarden once for every SGNL tool, terminal and agent session
# (lib/bwsession.py): asks for the master password, writes the session
# key to ~/.cache/sgnl/bw-session (600), good for 12 h (lib/bwsession.py). Lock again with bin/sgnl-lock,
# e.g. at the end of the day.
#
#   bin/sgnl-unlock --instance <name>
#
# The instance's own vault: the real one for a real instance; for a dev
# instance its dev vault (own bw data dir, unlocked with the dev owner's
# stored master password: bin/sgnl-dev unlock, no prompt).
#
# Each unlock makes earlier session keys invalid, also ones other
# sessions hold in their own BW_SESSION; tools using the shared file just
# pick up the new key.
set -euo pipefail
cd "$(dirname "$0")/.."
source lib/instance.sh   # mandatory --instance <name> (or SGNL_INSTANCE)
if [[ ${SGNL_ENV:-} == dev ]]; then exec bin/sgnl-dev unlock; fi
F=${SGNL_BW_SESSION_FILE:-$HOME/.cache/sgnl/bw-session}
status=$(bw status | python3 -c 'import json, sys; print(json.load(sys.stdin)["status"])')
if [[ $status == unauthenticated ]]; then
  echo "bw is not logged in: bw login --apikey (docs/DEPLOY.md §0)" >&2; exit 1
fi
key=$(bw unlock --raw)   # prompts for the master password
# bw can exit 0 with no key (e.g. no terminal for the hidden prompt).
if [[ -z $key ]]; then
  echo "sgnl-unlock: not unlocked (no session key from bw). Run it in a terminal, not via '!'." >&2
  exit 1
fi
umask 077
mkdir -p "$(dirname "$F")"
printf %s "$key" > "$F.tmp" && mv "$F.tmp" "$F"
echo "Vaultwarden unlocked for all SGNL tools and agent sessions, until bin/sgnl-lock (or 12 h)."
