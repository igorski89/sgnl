#!/usr/bin/env bash
# Deploys one app the safe way: a committed tree only (so the image tag is a
# real commit, never "_uncommitted"), stop-first for the apps that can't run
# twice on the same data (Forgejo, Stalwart: docs/DEPLOY.md), secrets via
# bin/sgnl-env, then checks the app answers on its public URL. A stop-first
# deploy that fails boots the version that ran before. The full Kamal
# output goes to ~/.cache/sgnl/deploy/; its end is shown on failure.
#
#   bin/sgnl-deploy <app>               # e.g. bulwark, forgejo, stalwart
#   bin/sgnl-deploy --stop-first <app>  # e.g. keycloak version bumps
#   bin/sgnl-deploy --all               # every app config, least critical first
#
# <app> = the <app> in config/deploy.<app>.yml. Accessory-only configs
# (vendor images: dashy, bulwark, listmonk, collabora) reboot their
# proxied accessory after pulling its image; --all leaves them out (name
# them). Databases and monitoring parts are not touched; use kamal
# accessory ... for those.
set -euo pipefail
cd "$(dirname "$0")/.."
source lib/instance.sh

STOP_FIRST=" forgejo stalwart "   # second container can't open the same store
ORDER=(monitoring opencloud vaultwarden keycloak forgejo stalwart)
LOGS=$HOME/.cache/sgnl/deploy

stop_flag=""
[[ ${1:-} == --stop-first ]] && { stop_flag=1; shift; }
[[ $# == 1 ]] || { echo "usage: $0 [--stop-first] <app> | --all" >&2; exit 1; }
mkdir -p "$LOGS"
# What gets shown of Kamal's output (it includes app logs when a boot
# fails): every secret value and AWS key id replaced. The log file itself
# stays complete (~/.cache, this Mac only).
redact() {
  bin/sgnl-env python3 -u -c '
import os, re, sys
vals = sorted({v for k, v in os.environ.items() if k.startswith("SGNL_SECRET_") and len(v) >= 8}, key=len, reverse=True)
for line in sys.stdin:
    for v in vals:
        line = line.replace(v, "[secret]")
    sys.stdout.write(re.sub(r"\b(AKIA|ASIA)[A-Z0-9]{16}\b", "[aws-key-id]", line))'
}
[[ -z $(git status --porcelain) ]] || {
  echo "uncommitted changes: commit first (the image tag must be a real commit)" >&2; git status --short >&2; exit 1; }

deploy_one() {
  local app=$1 cfg=config/deploy.$1.yml host path
  [[ -f $cfg ]] || { echo "no $cfg" >&2; return 1; }
  echo "==> $app ($(git rev-parse --short HEAD))"
  # Accessory-only configs (plain vendor images, e.g. dashy): restart the
  # accessories behind the proxy (the app; databases are left alone).
  local log; log=$LOGS/$app-$(date +%Y%m%d-%H%M%S).log
  local accs; accs=$(ruby -rkamal -e '
    c = Kamal::Configuration.create_from(config_file: Pathname.new(ARGV[0]), version: "x")
    c.accessories.select(&:running_proxy?).each { |a| puts "#{a.name} #{a.image}" } if c.raw_config.servers.nil?' "$cfg" 2>/dev/null) || accs=""
  [[ $app == collabora ]] && bin/sgnl-collabora-proof-key
  if [[ -n $accs ]]; then
    local acc image
    while read -r acc image; do
      # Pull first: a wrong image tag fails here, while the old one still runs.
      echo "    accessory $acc: pull $image"
      ssh -n "root@$SGNL_HOST" docker pull -q "$image" >>"$log" 2>&1 || { tail -5 "$log" | redact >&2; echo "    PULL FAILED: $image (nothing changed; log: $log)" >&2; return 1; }
      echo "    accessory $acc: reboot (a few seconds down)"
      bin/sgnl-env kamal accessory reboot "$acc" -c "$cfg" </dev/null >>"$log" 2>&1 ||
        { tail -25 "$log" | redact >&2; echo "    REBOOT FAILED: $app/$acc (log: $log)" >&2; return 1; }
    done <<<"$accs"
  else
    local prev=""
    if [[ -n $stop_flag || $STOP_FIRST == *" $app "* ]]; then
      prev=$(bin/sgnl-env kamal app version -q -c "$cfg" 2>/dev/null | grep -Eo '^[0-9a-f]{40}$' | tail -1) || prev=""
      echo "    stop first: $app can't run two containers on its data (brief downtime; running: ${prev:-none})"
      bin/sgnl-env kamal app stop -c "$cfg" >>"$log" 2>&1
    fi
    if ! bin/sgnl-env kamal deploy -c "$cfg" 2>&1 | tee -a "$log" | { grep --line-buffered -E "ERROR|healthy|Finished all" || true; } | redact >&2; then
      tail -25 "$log" | redact >&2
      echo "    DEPLOY FAILED: $app (log: $log)" >&2
      if [[ -n $prev ]] && ! grep -q "docker run --detach" "$log"; then
        # The new version never started (build, push, pull, network):
        # the data is as the old version left it.
        echo "    the new version never started: booting the previous one, $prev" >&2
        bin/sgnl-env kamal app boot -c "$cfg" --version "$prev" >>"$log" 2>&1 &&
          echo "    previous version $prev is running again" >&2 ||
          echo "    BOOT FAILED too: bin/sgnl-env kamal app boot -c $cfg --version $prev" >&2
      elif [[ -n $prev ]]; then
        # It started, so it may have migrated the data: an older version on
        # a newer schema is no rollback. Read the log first.
        echo "    $app is DOWN. The new version started and may have migrated its data, so" >&2
        echo "    booting $prev isn't safe without checking. Without a migration:" >&2
        echo "    bin/sgnl-env kamal app boot -c $cfg --version $prev; with one: restore (docs/BACKUPS.md)." >&2
      fi   # without stop-first, kamal kept the old container running
      return 1
    fi
  fi
  # Public check: proxy host + healthcheck path from the config.
  read -r host path < <(ruby -rkamal -e '
    c = Kamal::Configuration.create_from(config_file: Pathname.new(ARGV[0]), version: "x")
    p = c.raw_config.to_h[:proxy] || c.accessories.find(&:running_proxy?)&.then { |a| c.raw_config.to_h[:accessories][a.name]["proxy"] } || {}
    puts [p["host"], (p.dig("healthcheck", "path") || "/")].join(" ")' "$cfg" 2>/dev/null) || true   # top level: symbols, inside: strings
  if [[ -n ${host:-} ]]; then
    local code; code=$(curl -s -o /dev/null -m 20 -w "%{http_code}" "https://$host$path")
    [[ $code =~ ^(2|3)[0-9][0-9]$ ]] || { echo "    CHECK FAILED: https://$host$path -> $code" >&2; return 1; }
    echo "    https://$host$path -> $code"
  fi
}

if [[ $1 == --all ]]; then
  for app in "${ORDER[@]}"; do deploy_one "$app" || exit 1; done
else
  deploy_one "$1"
fi
