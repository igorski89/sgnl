#!/usr/bin/env python3
"""The one place that reads SGNL secrets. Every script and .kamal/secrets
calls this instead of a password manager, so the store can change
without touching them.

  bin/sgnl-secret <name>      value on stdout (no newline)
  bin/sgnl-secret --list      names only
  bin/sgnl-secret --json      all names and values as JSON on stdout (for pipes)
  bin/sgnl-secret --check     exit 0 if the store answers
  bin/sgnl-secret --set <name>   store a new value read from stdin
                                 (bw: updates the item, or creates it in "SGNL infra")

<name>: the full item name (example-sgnl-restic-password) or the
short one (restic-password).

Speed: one Vaultwarden lookup takes ~3 s. bin/sgnl-env fetches every
secret once and passes them to a command in its environment
(SGNL_SECRET_<NAME>), where this script finds them first:

  bin/sgnl-env kamal deploy -c config/deploy.forgejo.yml

Store, from SGNL_SECRETS (default: bw):
  bw           Vaultwarden through the Bitwarden CLI: Login items named as
               above (folder "SGNL infra"), value in the password field.
               Needs: export BW_SESSION=$(bw unlock --raw)
  keychain     the macOS login Keychain (the store until 2026-11)
  csv:<path>   secrets.csv from the bootstrap bundle (docs/RECOVERY.md),
               for a rebuild while Vaultwarden itself is down
"""
import base64, csv, json, os, subprocess, sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import instance  # noqa: E402  (instance/sgnl.env)
PREFIX = instance.get("SGNL_PREFIX") + "-"


def full(name):
    return name if name.startswith(PREFIX) else PREFIX + name


def env_name(name):
    return "SGNL_SECRET_" + full(name)[len(PREFIX):].upper().replace("-", "_")


def fail(msg):
    sys.exit(f"sgnl-secret: {msg}")


def from_bw():
    if not os.environ.get("BW_SESSION"):
        fail("Vaultwarden is locked: run  export BW_SESSION=$(bw unlock --raw)")
    r = subprocess.run(["bw", "list", "items", "--search", PREFIX, "--nointeraction"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        fail("bw: " + (r.stderr.strip() or r.stdout.strip())[-300:])
    out = {}
    for it in json.loads(r.stdout):
        if it.get("type") == 1 and it["name"].startswith(PREFIX) and not it.get("deletedDate"):
            if it["name"] in out:
                fail(f"two items named {it['name']} in Vaultwarden")
            out[it["name"]] = (it.get("login") or {}).get("password") or ""
    return out


def from_csv(path):
    with open(path, newline="") as f:
        return {r["Username"]: r["Password"] for r in csv.DictReader(f)
                if r["Username"].startswith(PREFIX)}


def from_keychain(names=None):
    if names is None:
        dump = subprocess.run(["security", "dump-keychain"], capture_output=True, text=True).stdout
        tag = '"svce"<blob>="'
        names = sorted({l.strip()[len(tag):-1] for l in dump.splitlines()
                        if l.strip().startswith(tag + PREFIX)})
    out = {}
    for n in names:
        r = subprocess.run(["security", "find-generic-password", "-a", os.environ["USER"], "-s", n, "-w"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            out[n] = r.stdout.rstrip("\n")
    return out


def load(only=None):
    store = os.environ.get("SGNL_SECRETS", "bw")
    if store == "bw":
        return from_bw()
    if store == "keychain":
        return from_keychain(only)
    if store.startswith("csv:"):
        return from_csv(store[4:])
    fail(f"unknown SGNL_SECRETS={store} (bw, keychain, csv:<path>)")


def bw_run(*args, stdin=None):
    r = subprocess.run(["bw", *args, "--nointeraction"], input=stdin, capture_output=True, text=True)
    if r.returncode != 0:
        fail("bw " + args[0] + ": " + (r.stderr.strip() or r.stdout.strip())[-300:])
    return r.stdout


def set_value(name, value):
    store = os.environ.get("SGNL_SECRETS", "bw")
    if store == "keychain":
        r = subprocess.run(["security", "add-generic-password", "-U", "-a", os.environ["USER"], "-s", name, "-w"],
                           input=f"{value}\n{value}\n", text=True, capture_output=True)
        if r.returncode:
            fail("security: " + r.stderr.strip())
        return
    if store != "bw":
        fail(f"--set works with bw or keychain, not {store}")
    if not os.environ.get("BW_SESSION"):
        fail("Vaultwarden is locked: run  export BW_SESSION=$(bw unlock --raw)")
    enc = lambda o: base64.b64encode(json.dumps(o).encode()).decode()
    items = [i for i in json.loads(bw_run("list", "items", "--search", name))
             if i["name"] == name and i.get("type") == 1]
    if len(items) > 1:
        fail(f"two items named {name}")
    if items:
        item = items[0]
        item["login"]["password"] = value
        bw_run("edit", "item", item["id"], stdin=enc(item))
    else:
        folder = [f["id"] for f in json.loads(bw_run("list", "folders")) if f["name"] == "SGNL infra"]
        bw_run("create", "item", stdin=enc({
            "type": 1, "name": name, "folderId": folder[0] if folder else None, "notes": None,
            "login": {"username": name, "password": value, "uris": []},
            "favorite": False, "reprompt": 0, "fields": []}))


def main():
    args = sys.argv[1:]
    if len(args) == 2 and args[0] == "--set":
        value = sys.stdin.read().rstrip("\n")
        if not value:
            fail("--set: empty value on stdin")
        set_value(full(args[1]), value); return
    if len(args) != 1 or args[0] in ("-h", "--help"):
        sys.exit(__doc__)
    a = args[0]
    if a == "--list":
        print("\n".join(sorted(load()))); return
    if a == "--json":
        json.dump(load(), sys.stdout); return
    if a == "--check":
        load([]); return
    v = os.environ.get(env_name(a))
    if v is None:
        items = load([full(a)])
        if full(a) not in items:
            fail(f"no secret {full(a)} ({os.environ.get('SGNL_SECRETS', 'bw')})")
        v = items[full(a)]
    sys.stdout.write(v)


if __name__ == "__main__":
    main()
