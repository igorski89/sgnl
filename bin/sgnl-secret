#!/usr/bin/env python3
"""The one place that reads SGNL secrets. Every script and .kamal/secrets
calls this instead of a password manager, so the store can change
without touching them.

  bin/sgnl-secret <name>      value on stdout (no newline)
  bin/sgnl-secret --list      names only
  bin/sgnl-secret --json      all names and values as JSON on stdout (for pipes)
  bin/sgnl-secret --check     exit 0 if the store answers
  bin/sgnl-secret --set <name>   store a new value: hidden prompt in a
                                 terminal (paste, Enter), else stdin
                                 (bw: updates the item, or creates it in the
                                 organisation collection "SGNL", or
                                 $SGNL_BW_COLLECTION; without one, in the
                                 personal folder "SGNL infra")

<name>: the full item name (example-sgnl-restic-password) or the
short one (restic-password).

Speed: one Vaultwarden lookup takes ~3 s. bin/sgnl-env fetches every
secret once and passes them to a command in its environment
(SGNL_SECRET_<NAME>), where this script finds them first:

  bin/sgnl-env kamal deploy -c config/deploy.forgejo.yml

Store, from SGNL_SECRETS (default: bw):
  bw           Vaultwarden through the Bitwarden CLI: Login items named as
               above, value in the password field, found by name wherever
               they are (collection "SGNL", folder "SGNL infra", ...).
               Needs the vault unlocked: bin/sgnl-unlock (or BW_SESSION set)
  dummy        FAKE-<name> for any secret: checks and the example instance
               (bin/sgnl-config-dump, CI), never real
  csv:<path>   secrets.csv from the bootstrap bundle (docs/RECOVERY.md),
               for a rebuild while Vaultwarden itself is down
"""
import base64, csv, json, os, subprocess, sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import instance  # noqa: E402  (instance/sgnl.env)
import bwsession  # noqa: E402  (shared session from bin/sgnl-unlock)
bwsession.ensure()
PREFIX = instance.get("SGNL_PREFIX") + "-"
# Vaultwarden organisation collection that new secrets go into (--set).
COLLECTION = os.environ.get("SGNL_BW_COLLECTION", "SGNL")


def full(name):
    return name if name.startswith(PREFIX) else PREFIX + name


def env_name(name):
    return "SGNL_SECRET_" + full(name)[len(PREFIX):].upper().replace("-", "_")


def fail(msg):
    sys.exit(f"sgnl-secret: {msg}")


def from_bw():
    if not os.environ.get("BW_SESSION"):
        fail("Vaultwarden is locked: run  bin/sgnl-unlock")
    r = subprocess.run(["bw", "list", "items", "--search", PREFIX, "--nointeraction"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        fail("bw: " + (r.stderr.strip() or r.stdout.strip())[-300:])
    out = {}
    for it in json.loads(r.stdout):
        if it.get("type") == 1 and it["name"].startswith(PREFIX) and not it.get("deletedDate"):
            if it["name"] in out:
                fail(f"two items named {it['name']} in Vaultwarden")
            out[it["name"]] = (it.get("login") or {}).get("password") or ""
    return out


def from_csv(path):
    with open(path, newline="") as f:
        return {r["Username"]: r["Password"] for r in csv.DictReader(f)
                if r["Username"].startswith(PREFIX)}


def from_dummy(names=None):
    """Fake values for checks and the example instance: FAKE-<short name>."""
    return {n: "FAKE-" + n[len(PREFIX):] for n in (names or [])}


def load(only=None):
    store = os.environ.get("SGNL_SECRETS", "bw")
    if store == "bw":
        return from_bw()
    if store == "dummy":
        return from_dummy(only)
    if store.startswith("csv:"):
        return from_csv(store[4:])
    fail(f"unknown SGNL_SECRETS={store} (bw, dummy, csv:<path>)")


def bw_run(*args, stdin=None):
    r = subprocess.run(["bw", *args, "--nointeraction"], input=stdin, capture_output=True, text=True)
    if r.returncode != 0:
        fail("bw " + args[0] + ": " + (r.stderr.strip() or r.stdout.strip())[-300:])
    return r.stdout


def set_value(name, value):
    store = os.environ.get("SGNL_SECRETS", "bw")
    if store.startswith("csv:") and os.environ.get("SGNL_ENV") == "dev":
        # A dev environment's generated secrets file (bin/sgnl-dev). Never
        # the recovery bundle's CSV: that one stays read-only.
        path = store[4:]
        with open(path, newline="") as f:
            rows = {r["Username"]: r["Password"] for r in csv.DictReader(f)}
        rows[name] = value
        old = os.umask(0o077)
        try:
            with open(path + ".tmp", "w", newline="") as f:
                w = csv.DictWriter(f, fieldnames=["Username", "Password"]); w.writeheader()
                for k in sorted(rows): w.writerow({"Username": k, "Password": rows[k]})
        finally:
            os.umask(old)
        os.replace(path + ".tmp", path); return
    if store != "bw":
        fail(f"--set works with bw (or a dev instance's csv) only, not {store}")
    if not os.environ.get("BW_SESSION"):
        fail("Vaultwarden is locked: run  bin/sgnl-unlock")
    enc = lambda o: base64.b64encode(json.dumps(o).encode()).decode()
    items = [i for i in json.loads(bw_run("list", "items", "--search", name))
             if i["name"] == name and i.get("type") == 1]
    if len(items) > 1:
        fail(f"two items named {name}")
    if items:
        item = items[0]
        item["login"]["password"] = value
        bw_run("edit", "item", item["id"], stdin=enc(item))
    else:
        # New items go into the organisation collection COLLECTION (shared
        # with whoever the collection is shared with); without one, into
        # the personal folder "SGNL infra".
        cols = [c for c in json.loads(bw_run("list", "collections")) if c["name"] == COLLECTION]
        if len(cols) > 1:
            fail(f"two collections named {COLLECTION}")
        folder = [f["id"] for f in json.loads(bw_run("list", "folders")) if f["name"] == "SGNL infra"]
        created = json.loads(bw_run("create", "item", stdin=enc({
            "type": 1, "name": name, "folderId": None if cols else (folder[0] if folder else None),
            "notes": None, "login": {"username": name, "password": value, "uris": []},
            "favorite": False, "reprompt": 0, "fields": []})))
        if cols:
            bw_run("move", created["id"], cols[0]["organizationId"], stdin=enc([cols[0]["id"]]))
            print(f"created {name} in collection {COLLECTION}", file=sys.stderr)
        else:
            print(f"created {name} in My vault (no collection {COLLECTION!r})", file=sys.stderr)


def main():
    args = sys.argv[1:]
    if len(args) == 2 and args[0] == "--set":
        # In a terminal: a hidden prompt (paste, Enter). Piped: stdin.
        if sys.stdin.isatty():
            import getpass
            value = getpass.getpass(f"value for {full(args[1])} (hidden): ").strip()
        else:
            value = sys.stdin.read().rstrip("\n")
        if not value:
            fail("--set: empty value on stdin")
        set_value(full(args[1]), value); return
    if len(args) != 1 or args[0] in ("-h", "--help"):
        sys.exit(__doc__)
    a = args[0]
    if a == "--list":
        print("\n".join(sorted(load()))); return
    if a == "--json":
        json.dump(load(), sys.stdout); return
    if a == "--check":
        load([]); return
    v = os.environ.get(env_name(a))
    if v is None:
        items = load([full(a)])
        if full(a) not in items:
            fail(f"no secret {full(a)} ({os.environ.get('SGNL_SECRETS', 'bw')})")
        v = items[full(a)]
    sys.stdout.write(v)


if __name__ == "__main__":
    main()
