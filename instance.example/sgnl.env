# An SGNL instance: the values that make it yours. Copy this folder to
# instance/ (its own private git repo, ignored by this one) and edit.
# Configs, deploy files and scripts read these values.
# Format: KEY=value or KEY="value", comments on their own lines only
# (read by shell `source`, Ruby dotenv and lib/instance.py alike).

# Company name, as shown to people.
SGNL_ORG_NAME="Example Org"
# Company domain: mail addresses (alice@...).
SGNL_DOMAIN=example.com
# Apps live at <app>.SGNL_APPS_DOMAIN (id., drive., mail., ...).
SGNL_APPS_DOMAIN=sgnl.example.com
# The server's IP address.
SGNL_HOST=203.0.113.10
# Keycloak realm (part of every login URL: never rename on a live system).
SGNL_REALM=example
SGNL_TZ=UTC
# Prefix for secrets (Vaultwarden items), AWS resources, buckets.
SGNL_PREFIX=example-sgnl
# Outgoing mail relay (AWS SES SMTP endpoint, its region).
SGNL_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
# Optional: another app sharing the server whose monitoring rules and
# dashboards SGNL's monitoring also loads (/root/<name>-monitoring/...).
# Leave empty if SGNL has the server to itself.
SGNL_COTENANT=
# Short company name in identifiers (Forgejo org, Cloudflare DNS label).
SGNL_ORG_SLUG=example
# Backups: Cloudflare R2 endpoint (<account-id>.eu.r2.cloudflarestorage.com) and bucket.
SGNL_R2_ENDPOINT=0123456789abcdef0123456789abcdef.eu.r2.cloudflarestorage.com
SGNL_BACKUP_BUCKET=example-sgnl-backups
# Where backup failures go: outside SGNL (not on its own mail server).
SGNL_ALERT_EMAIL=owner@personal.example
# The first admin (Keycloak username): default account in restore tests,
# Forgejo site admin, protected from self-suspension.
SGNL_ADMIN_USER=alice
