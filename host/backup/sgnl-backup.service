[Unit]
Description=sgnl nightly backup to R2 (docs/BACKUPS.md)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/opt/sgnl/backup/sgnl-backup.sh
Nice=10
IOSchedulingClass=idle
# Backstop for anything the script's own timeouts don't catch.
TimeoutStartSec=3h
