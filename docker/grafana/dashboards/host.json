        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (name) (rate(container_network_receive_bytes_total{job=\"cadvisor\",name!=\"\",container_tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
