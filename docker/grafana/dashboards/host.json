        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Network out by container (top 10)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (name) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",name!=\"\",container_tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
