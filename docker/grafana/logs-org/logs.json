{
  "uid": "sgnl-logs",
  "title": "Logs",
  "tags": [
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "description": "Every container's output and the host journal (VictoriaLogs, 30 days). Tenant picks the co-tenant app / sgnl / infra (kamal-proxy, host journal); the filter is LogsQL on top, e.g. service:sgnl-forgejo AND error, or tenant:sgnl. Secrets and personal data are redacted before storage (monitoring/vector/vector.yaml).",
  "templating": {
    "list": [
      {
        "name": "scope",
        "label": "Tenant",
        "type": "custom",
        "query": "all : *, sgnl : tenant:sgnl, infra : tenant:infra",
        "current": {
          "text": "all",
          "value": "*"
        },
        "options": [
          {
            "text": "all",
            "value": "*",
            "selected": true
          },
          {
            "text": "sgnl",
            "value": "tenant:sgnl",
            "selected": false
          },
          {
            "text": "infra",
            "value": "tenant:infra",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "filter",
        "label": "LogsQL filter",
        "type": "textbox",
        "query": "*",
        "current": {
          "text": "*",
          "value": "*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Lines per service",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "statsRange",
          "expr": "$scope AND ($filter) | stats by (service) count() as lines",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors per service (error, fatal, panic, traceback, 5xx)",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "statsRange",
          "expr": "$scope AND ($filter) AND (i(error) OR i(fatal) OR i(panic) OR i(traceback) OR http.status:>=500) | stats by (service) count() as errors",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Lines",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 18
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "showLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "$scope AND ($filter)",
          "maxLines": 1000
        }
      ]
    }
  ]
}
